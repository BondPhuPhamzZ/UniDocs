@page
@model UniDocs.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Reports Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="headline-md text-dark mb-0">Documents Report</h2>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 60vh; overflow-y: auto;">
            <table class="table table-hover align-top mb-0 text-start">
                <thead class="table-light position-sticky top-0 shadow-sm" style="z-index: 1;">
                    <tr>
                        <th class="ps-4 py-3 text-nowrap">DocName</th>
                        <th class="py-3 text-nowrap">Reporter</th>
                        <th class="py-3 text-nowrap">Reason</th>
                        <th class="py-3 text-nowrap">Reported date</th>
                        <th class="py-3 text-nowrap">Status</th>
                        <th class="pe-4 py-3 text-nowrap">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Reports.Any())
                    {
                        foreach (var item in Model.Reports)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <a asp-controller="Document" asp-action="Detail" asp-route-id="@item.DocumentId" class="fw-bold text-decoration-none text-primary">
                                        @(item.Document?.Title ?? "Document not found")
                                    </a>
                                </td>
                                <td class="py-3">
                                    <span class="fw-bold">@(item.Reporter?.LastName) @(item.Reporter?.FirstName)</span>
                                </td>
                                <td class="py-3 text-danger fw-medium">
                                    @item.Reason
                                </td>
                                <td class="py-3 text-muted small">
                                    @item.ReportDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="py-3">
                                    @if (item.Status == UniDocs.Models.Enums.ReportStatusEnum.Pending)
                                    {
                                        <span class="fw-bold text-warning">Pending</span>
                                    }
                                    else if (item.Status == UniDocs.Models.Enums.ReportStatusEnum.Finished)
                                    {
                                        <span class="fw-bold text-success">Finished</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-info">@item.Status</span>
                                    }
                                </td>
                                <td class="pe-4 py-3">
                                    @if (item.Status == UniDocs.Models.Enums.ReportStatusEnum.Pending)
                                    {
                                        <div class="d-flex gap-2">
                                            <form method="post" asp-page-handler="DismissReport" asp-route-id="@item.Id" class="d-inline">
                                                <button type="submit" class="btn btn-outline-success btn-sm px-3 fw-bold">
                                                    Dismiss
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="DeleteDocument" asp-route-id="@item.DocumentId" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this document? This will delete the physical file but keep the report history.');">
                                                <button type="submit" class="btn btn-danger btn-sm px-3 fw-bold">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">

                                Great! There are no pending reports.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
