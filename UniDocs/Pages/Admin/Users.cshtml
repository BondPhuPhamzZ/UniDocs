@page
@model UniDocs.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="headline-md text-dark mb-0">User Management</h2>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-primary alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 60vh; overflow-y: auto;">
            <table class="table table-hover align-top mb-0 text-start">
                <thead class="table-light position-sticky top-0 shadow-sm" style="z-index: 1;">
                    <tr>
                        <th class="ps-4 py-3 text-nowrap">ID</th>
                        <th class="py-3 text-nowrap">Full Name</th>
                        <th class="py-3 text-nowrap">Email</th>
                        <th class="py-3 text-nowrap">Docs Count</th>
                        <th class="py-3 text-nowrap">Status</th>
                        <th class="pe-4 py-3 text-nowrap">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.UserList)
                    {
                        <tr>
                            <td class="ps-4 py-3 fw-bold text-muted">#@user.Id</td>
                            <td class="py-3 fw-medium text-dark">@user.LastName @user.FirstName</td>
                            <td class="py-3 text-muted">@user.Email</td>
                            <td class="py-3">
                                @(user.Documents?.Count ?? 0)
                            </td>
                            <td class="py-3">
                                @if (user.IsActive)
                                {
                                    <span class="fw-bold text-primary">Active</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-danger">Locked</span>
                                }
                            </td>
                            <td class="pe-4 py-3">
                                @if (user.Role == UniDocs.Models.Enums.RoleEnum.Admin)
                                {
                                    <span class="badge bg-primary px-3 py-2 rounded-pill">Admin</span>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="ToggleLock" asp-route-id="@user.Id" class="d-inline">
                                        @if (user.IsActive)
                                        {
                                            <button type="submit" class="btn btn-outline-danger btn-sm px-3 fw-bold rounded-pill">
                                                Lock
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-primary btn-sm px-3 fw-bold rounded-pill">
                                                Unlock
                                            </button>
                                        }
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
