@page
@model UniDocs.Pages.Admin.CoursesModel
@{
    ViewData["Title"] = "Course Catalog";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="headline-md text-dark mb-0">Courses Catalog</h2>
    <button class="btn btn-primary px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addCourseModal">
        <i class="bi bi-plus-lg me-1"></i> Add course
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    @foreach (var course in Model.CourseList)
    {
        <div class="col">
            <div class="card h-100 border-0 shadow-sm rounded-4 position-relative document-card-hover">
                
                <div class="position-absolute top-0 end-0 mt-3 me-3 d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-primary" title="Update course" data-bs-toggle="modal" data-bs-target="#editCourseModal-@course.Id">
                        <i class="bi bi-pencil"></i>
                    </button>
                    @if (course.Documents.Count == 0)
                    {
                        <form method="post" asp-page-handler="DeleteCourse" asp-route-id="@course.Id" onsubmit="return confirm('Delete this course?');">
                            <button type="submit" class="btn btn-sm btn-danger" title="Delete course">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    }
                </div>

                <div class="card-body p-4 text-center">
                    <h5 class="title-lg text-dark mb-1 mt-4">@course.CourseName</h5>
                    <p class="text-muted body-md mb-3">CourseID: <span class="fw-medium">@course.CourseCode</span></p>
                    
                    <div class="bg-secondary-soft px-3 py-2">
                        @course.Documents.Count docs
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* Modal Thêm môn học *@
<div class="modal fade" id="addCourseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form method="post" asp-page-handler="AddCourse">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold">Add New Course</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">Course name</label>
                        <input type="text" asp-for="NewCourse.CourseName" class="form-control" required placeholder="E.g: Advanced Web" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">CourseID</label>
                        <input type="text" asp-for="NewCourse.CourseCode" class="form-control" required placeholder="E.g: SE104" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">Department</label>
                        <select asp-for="NewCourse.Department" class="form-select">
                            <option value="Công nghệ Phần mềm">Công nghệ Phần mềm</option>
                            <option value="Hệ thống Thông tin">Hệ thống Thông tin</option>
                            <option value="Khoa học Máy tính">Khoa học Máy tính</option>
                            <option value="Kỹ thuật Máy tính">Kỹ thuật Máy tính</option>
                            <option value="Mạng Máy tính & Truyền thông">Mạng Máy tính & Truyền thông</option>
                            <option value="Khoa học & Kỹ thuật Thông tin">Khoa học & Kỹ thuật Thông tin</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal Sửa môn học (Render cho mỗi môn) *@
@foreach (var course in Model.CourseList)
{
    <div class="modal fade" id="editCourseModal-@course.Id" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <form method="post" asp-page-handler="EditCourse" asp-route-id="@course.Id">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="modal-title fw-bold">Update Course</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Course name</label>
                            <input type="text" name="courseName" class="form-control" required value="@course.CourseName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">CourseID</label>
                            <input type="text" name="courseCode" class="form-control" required value="@course.CourseCode" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Department</label>
                            <select name="department" class="form-select">
                                @{
                                    string[] depts = { "Công nghệ Phần mềm", "Hệ thống Thông tin", "Khoa học Máy tính", "Kỹ thuật Máy tính", "Mạng Máy tính & Truyền thông", "Khoa học & Kỹ thuật Thông tin" };
                                    foreach (var dept in depts)
                                    {
                                        if (course.Department == dept)
                                        {
                                            <option value="@dept" selected>@dept</option>
                                        }
                                        else
                                        {
                                            <option value="@dept">@dept</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 pt-0">
                        <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
