<!doctype html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniDoc Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    @* Navbar Admin *@
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm sticky-top" style="z-index: 1000;">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center text-white" asp-page="/Admin/Dashboard">
                <i class="bi bi-journal-text fs-3 me-2 text-white"></i>
                <strong class="text-white">Admin</strong>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Admin/Dashboard">Reports</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Admin/Users">Users</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Admin/Courses">Courses</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-light small">Welcome, <strong>Admin</strong>!</span>

                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm px-3 fw-medium">
                        Back to Home
                    </a>
                </div>
            </div>
        </div>
    </nav>

    @* Layout chính *@
    <div class="container-fluid px-4 py-4 flex-grow-1">
        <div class="row">

           @* Tái sử dụng Sidebar quản trị *@
            <div class="col-lg-2 mb-4">
                <div class="list-group shadow-sm">
                    <a asp-page="/Admin/Dashboard" class="list-group-item list-group-item-action">
                        Reported Documents
                    </a>
                    <a asp-page="/Admin/Users" class="list-group-item list-group-item-action">
                        User Management
                    </a>
                    <a asp-page="/Admin/Courses" class="list-group-item list-group-item-action">
                        Course Management
                    </a>
                </div>
            </div>

            <div class="col-lg-10">
                @RenderBody()
            </div>

        </div>
    </div>

    @* Footer *@
    <footer class="bg-primary text-light py-3 mt-auto">
        <div class="container text-center">
            <p class="small text-white-50 mb-0">© 2026 UniDoc Admin Panel.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>