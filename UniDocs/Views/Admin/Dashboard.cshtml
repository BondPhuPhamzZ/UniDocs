@model IEnumerable<UniDocs.Models.Report>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Báo cáo";
}

@* Hiển thị thông báo thành công *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 fw-bold">
        <i class="bi bi-flag-fill text-danger me-2"></i>Tài liệu bị Báo cáo vi phạm
    </h4>
    <span class="badge bg-danger fs-6">@Model.Count() báo cáo</span>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Tài liệu bị báo cáo</th>
                        <th>Người báo cáo</th>
                        <th>Lý do</th>
                        <th>Ngày báo cáo</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var report in Model)
                        {
                            <tr>
                                @* Các thông tin của tài liệu bị report *@
                                <td class="ps-4">
                                    <div class="fw-bold">@report.Document?.Title</div>
                                    <div class="text-muted small">ID: #@report.DocumentId</div>
                                </td>

                                <td>
                                    <div>@report.Reporter?.LastName @report.Reporter?.FirstName</div>
                                    <div class="text-muted small">@report.Reporter?.Email</div>
                                </td>

                                <td>
                                    <span class="badge bg-danger-subtle text-danger">@report.Reason</span>
                                </td>

                                <td class="text-muted small">@report.ReportDate.ToString("dd/MM/yyyy HH:mm")</td>

                                @* Hiển thị trạng thái Report *@
                                <td>
                                    @if (report.Status == "Đã xử lý")
                                    {
                                        <span class="badge bg-success">Đã xử lý</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Đang xử lý</span>
                                    }
                                </td>

                                @* Thực hiện các chức năng *@
                                <td class="text-end pe-4">

                                    @* Nút Xóa tài liệu *@
                                    <form asp-action="DeleteDocument" asp-route-id="@report.DocumentId"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Xóa vĩnh viễn tài liệu này?')">
                                        <button class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </form>

                                    @* Nút Bỏ qua *@
                                    <form asp-action="DismissReport" asp-route-id="@report.Id"
                                          method="post" class="d-inline ms-1">
                                        <button class="btn btn-sm btn-success">
                                            <i class="bi bi-check-lg"></i> Bỏ qua
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-shield-check fs-1 d-block mb-2 text-success"></i>
                                Không có báo cáo vi phạm nào! Tất cả đều ổn.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>