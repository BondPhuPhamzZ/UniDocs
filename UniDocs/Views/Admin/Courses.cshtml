@model IEnumerable<UniDocs.Models.Course>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Danh mục Môn học";
}

@* Thông báo thành công *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Khu vực ở trên bên phải *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 fw-bold">
        <i class="bi bi-book-fill me-2"></i>Danh sách Môn học
    </h4>
    <div class="d-flex gap-2">
        <span class="badge bg-primary fs-6">@Model.Count() môn học</span>

        <button class="btn btn-success btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#addCourseModal">
            <i class="bi bi-plus-circle"></i> Thêm môn học mới
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã môn</th>
                        <th>Tên môn học</th>
                        <th>Thuộc Khoa</th>
                        <th class="text-center">Số tài liệu</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var course in Model)
                        {
                            <tr>
                                @* Hiển thị thông tin của các môn học *@
                                <td class="ps-4 fw-bold text-primary">@course.CourseCode</td>
                                <td class="fw-bold">@course.CourseName</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(course.Department ?? "—")
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="badge bg-primary rounded-pill">@course.Documents.Count</span>
                                </td>

                                @* Nút Xóa - chỉ cho xóa môn học nếu không có tài liệu nào *@
                                <td class="text-end pe-4">
                                    @if (course.Documents.Count == 0)
                                    {
                                        <form asp-action="DeleteCourse" asp-route-id="@course.Id"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Xóa môn học @course.CourseName?')">
                                            <button class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger" disabled
                                                title="Không thể xóa - môn học đang có @course.Documents.Count tài liệu">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-book fs-1 d-block mb-2"></i>
                                Chưa có môn học nào. Hãy thêm mới!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@* ===== Modal Thêm môn học (hiển thị khi click vào nút trên) ===== *@
<div class="modal fade" id="addCourseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">

            @* Chức năng Thêm môn học mới *@
            <div class="modal-header bg-success text-white border-0">
                <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Thêm Môn học Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="AddCourse" method="post">
                <div class="modal-body p-4">
                    @* Các thông tin của Môn học *@
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Mã môn học <span class="text-danger">*</span></label>
                        <input type="text" name="CourseCode" class="form-control"
                               placeholder="VD: IT202" required maxlength="20" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Tên môn học <span class="text-danger">*</span></label>
                        <input type="text" name="CourseName" class="form-control"
                               placeholder="VD: Trí tuệ nhân tạo" required maxlength="200" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Thuộc Khoa</label>
                        <input type="text" name="Department" class="form-control"
                               placeholder="VD: Công nghệ thông tin" maxlength="100" />
                    </div>
                </div>

                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success fw-bold">
                        <i class="bi bi-plus-circle me-1"></i>Lưu môn học
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>