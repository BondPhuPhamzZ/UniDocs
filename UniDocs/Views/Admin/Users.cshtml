@model IEnumerable<UniDocs.Models.User>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Người dùng";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 fw-bold">
        <i class="bi bi-people-fill me-2"></i>Quản lý Danh sách Người dùng
    </h4>
    <span class="badge bg-primary fs-6">@Model.Count() người dùng</span>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Họ và Tên</th>
                        <th>Email</th>
                        <th>Trường Đại học</th>
                        <th class="text-center">Tài liệu đã đăng</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            @* Các thông tin của tài khoản *@
                            <td class="ps-4 fw-bold">
                                @user.LastName @user.FirstName
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-warning text-dark ms-1">Admin</span>
                                }
                            </td>
                            <td class="text-muted">@user.Email</td>
                            <td>@(user.University ?? "—")</td>
                            <td class="text-center">
                                <span class="badge bg-primary rounded-pill">@user.Documents.Count</span>
                            </td>

                            @* Hiển thị trạng thái tài khoản *@
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger">Bị khóa</span>
                                }
                            </td>

                            @* Thực hiện khóa/ mở khóa tài khoản cho User *@
                            <td class="text-end pe-4">
                                @if (user.Role != "Admin")
                                {
                                    <form asp-action="ToggleLock" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @if (user.IsActive)
                                        {
                                            <button class="btn btn-sm btn-danger">
                                                <i class="bi bi-lock-fill"></i> Khóa
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-success">
                                                <i class="bi bi-unlock-fill"></i> Mở khóa
                                            </button>
                                        }
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>