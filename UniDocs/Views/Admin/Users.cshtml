@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Người dùng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 fw-bold">Quản lý Danh sách Người dùng</h4>
    <div class="input-group" style="width: 300px">
        <input type="text" class="form-control form-control-sm" placeholder="Tìm email hoặc tên..." />
        <button class="btn btn-sm btn-outline-secondary" type="button">
            <i class="bi bi-search"></i>
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-4">Họ và Tên</th>
                        <th scope="col">Email</th>
                        <th scope="col">Trường Đại học</th>
                        <th scope="col">Tài liệu đã đăng</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4 fw-bold">Nam Nguyễn</td>
                        <td class="text-muted">namnguyen@student.edu.vn</td>
                        <td>ĐH Bách Khoa HN</td>
                        <td><span class="badge bg-primary rounded-pill">12</span></td>
                        <td><span class="badge bg-success-subtle text-success">Hoạt động</span></td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-danger"><i class="bi bi-lock-fill"></i> Khóa tài khoản</button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4 fw-bold">Minh Anh Lê</td>
                        <td class="text-muted">minhanh@student.edu.vn</td>
                        <td>ĐH Khoa học Tự nhiên</td>
                        <td><span class="badge bg-primary rounded-pill">5</span></td>
                        <td><span class="badge bg-danger-subtle text-danger">Bị khóa</span></td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-success"><i class="bi bi-unlock-fill"></i> Mở khóa</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
