<!doctype html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - UniDocs</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/style.css" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top" style="z-index: 1000;">

        <div class="container">

            <a class="navbar-brand d-flex align-items-center text-dark" asp-controller="Home" asp-action="Index">
                <i class="bi bi-journal-text fs-3 me-2 text-primary"></i>
                <strong>UniDoc</strong>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>


            @* ===== Các page trên thanh menu ===== *@
            <div class="collapse navbar-collapse" id="navbarContent">

                @* Khối các page (bên trái) *@
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-controller="Course" asp-action="Index">Danh mục môn học</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-controller="Document" asp-action="Upload">Đóng góp tài liệu</a>
                    </li>
                </ul>


                @* ===== Khối các Login/ Register (bên phải) ===== *@
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <span class="text-dark small me-2 d-none d-md-inline">Chào, <strong>@User.Identity.Name</strong></span>

                        @* Xem Profile *@
                        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-primary btn-sm px-2" title="Trang cá nhân">
                            <i class="bi bi-person-circle"></i>
                        </a>

                        @* Check role là Admin *@
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-warning btn-sm fw-bold px-2 text-dark" title="Quản trị">
                                <i class="bi bi-shield-lock-fill"></i>
                            </a>
                        }

                        @* Đăng xuất *@
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm px-2" title="Đăng xuất">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm fw-bold px-3">Đăng nhập</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm px-3">Đăng ký</a>
                    }
                </div>

            </div>

        </div>

    </nav>

    
    @* Toast thông báo toàn trang *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index: 9999">
            <div class="toast align-items-center text-white bg-success border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body fw-bold">
                        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }

    <!-- ================= RENDER BODY ================= -->
    <!-- Đây là nơi phần "ruột" của các trang (như Trang chủ, Đăng nhập) sẽ được nhét vào -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="bg-white border-top text-dark py-4 mt-auto">
        <div class="container text-center">
            <p class="mb-1"><strong>Đồ án Lập trình Web - Năm 2</strong></p>
            <p class="small text-muted mb-0">
                Thực hiện bởi Nhóm 1 • Sử dụng ASP.NET Core MVC & Bootstrap 5
            </p>
        </div>
    </footer>

    <!-- Link JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js"></script>

    <!-- Nơi chứa các script riêng của từng trang (sẽ học sau) -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

