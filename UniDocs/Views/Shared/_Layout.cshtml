<!doctype html>
<html lang="vi">
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - UniDocs</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/style.css" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .navbar-nav .nav-link.active {
            font-weight: 700 !important;
            border-bottom: 2px solid var(--bs-primary);
            color: var(--bs-primary) !important;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top" style="z-index: 1000;">

        <div class="container">

            <!-- Hamburger Menu (Mobile Only) -->
            <button class="btn btn-link border-0 text-dark me-2 d-lg-none p-1" type="button" data-bs-toggle="offcanvas" data-bs-target="#mainMenuOffcanvas" style="box-shadow: none;">
                <i class="bi bi-list fs-2"></i>
            </button>

            <a class="navbar-brand d-flex align-items-center text-dark" asp-controller="Home" asp-action="Index">
                <i class="bi bi-journal-text fs-3 me-2 text-primary"></i>
                <strong>UniDoc</strong>
            </a>

            <!-- Horizontal Menu (Desktop Only) -->
            <div class="collapse navbar-collapse d-none d-lg-flex ms-4">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-3">
                    <li class="nav-item">
                        <a class="nav-link fw-medium @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-medium @(currentController == "Course" ? "active" : "")" asp-controller="Course" asp-action="Index">Course</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-medium @(currentController == "Document" ? "active" : "")" asp-controller="Document" asp-action="Upload">Attribute</a>
                    </li>
                </ul>
            </div>

            @* ===== Phần tìm kiếm & Icons (Desktop Only) ===== *@
            <div class="d-none d-lg-flex flex-grow-1 justify-content-end align-items-center" id="navbarContent">

                @* Thanh tìm kiếm trên Navbar *@
                <form asp-controller="Course" asp-action="Index" method="get" class="d-flex mx-auto mb-0 px-3 flex-grow-1" style="max-width: 400px;">
                    <div class="input-group">
                        <input type="text" name="query" class="form-control bg-light shadow-none border-0 rounded-start px-4" placeholder="Search for course..." />
                        <button class="btn btn-light bg-light border-0 rounded-end pe-3 text-muted" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                @* ===== Khối các Login/ Register (bên phải) ===== *@
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Profile" class="btn btn-light border-0 fs-5 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;" title="Profile">
                            <i class="bi bi-person-circle text-primary"></i>
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-light border-0 fs-5 p-2 d-flex align-items-center justify-content-center text-primary" style="width: 40px; height: 40px; border-radius: 50%;" title="Admin Dashboard">
                                <i class="bi bi-shield-lock-fill"></i>
                            </a>
                        }

                        <a asp-controller="Account" asp-action="Logout" class="btn btn-light border-0 fs-5 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;" title="Logout">
                            <i class="bi bi-box-arrow-right text-danger"></i>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm fw-bold px-3">Login</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm px-3">Register</a>
                    }
                </div>

            </div>

        </div>

    </nav>

    <!-- Offcanvas Main Menu (Mobile) -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="mainMenuOffcanvas" style="width: 300px;">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title fw-bold d-flex align-items-center">
                <i class="bi bi-journal-text fs-3 me-2 text-primary"></i> UniDoc
            </h5>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-3 d-flex flex-column gap-3">
            
            @* Search Bar trên Mobile *@
            <form asp-controller="Course" asp-action="Index" method="get" class="d-flex w-100">
                <div class="input-group">
                    <input type="text" name="query" class="form-control bg-light shadow-none border-0 rounded-start-pill px-3" placeholder="Search..." />
                    <button class="btn btn-light bg-light border-0 rounded-end-pill text-muted" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>

            @* Menu chính *@
            <div class="list-group list-group-flush border-bottom pb-3">
                <a asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action py-3 border-0 fw-medium rounded-2 mb-1 @(currentController == "Home" ? "text-primary bg-primary-subtle" : "text-dark")">
                    <i class="bi bi-house-door fs-5 me-3"></i> Home
                </a>
                <a asp-controller="Course" asp-action="Index" class="list-group-item list-group-item-action py-3 border-0 fw-medium rounded-2 mb-1 @(currentController == "Course" ? "text-primary bg-primary-subtle" : "text-dark")">
                    <i class="bi bi-book fs-5 me-3"></i> Course
                </a>
                <a asp-controller="Document" asp-action="Upload" class="list-group-item list-group-item-action py-3 border-0 fw-medium rounded-2 @(currentController == "Document" ? "text-primary bg-primary-subtle" : "text-dark")">
                    <i class="bi bi-cloud-arrow-up fs-5 me-3"></i> Attribute
                </a>
            </div>

            @* Menu cá nhân (Profile, Admin, Logout) *@
            <div class="list-group list-group-flush">
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Account" asp-action="Profile" class="list-group-item list-group-item-action py-3 border-0 fw-medium rounded-2 mb-1 text-dark">
                        <i class="bi bi-person-circle fs-5 me-3 text-primary"></i> Profile
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="list-group-item list-group-item-action py-3 border-0 fw-medium rounded-2 mb-1 text-dark">
                            <i class="bi bi-shield-lock-fill fs-5 me-3 text-warning"></i> Admin Dashboard
                        </a>
                    }

                    <a asp-controller="Account" asp-action="Logout" class="list-group-item list-group-item-action py-3 border-0 fw-medium rounded-2 text-dark">
                        <i class="bi bi-box-arrow-right fs-5 me-3 text-danger"></i> Logout
                    </a>
                }
                else
                {
                    <div class="d-flex gap-2 mt-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary fw-bold flex-grow-1">Login</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary fw-bold flex-grow-1">Register</a>
                    </div>
                }
            </div>

        </div>
    </div>
    
    @* Toast thông báo toàn trang *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index: 9999">
            <div class="toast align-items-center text-white bg-primary border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body fw-bold">
                        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }

    <!-- ================= RENDER BODY ================= -->
    <!-- Đây là nơi phần "ruột" của các trang (như Trang chủ, Đăng nhập) sẽ được nhét vào -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="bg-white border-top text-dark py-4 mt-auto">
        <div class="container text-center">
            <p class="mb-1"><strong>UniDocs</strong></p>
            <p class="small text-muted mb-0">
                Gia Phú - Chí Kiệt - Điền Viên
            </p>
        </div>
    </footer>

    <!-- Link JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js"></script>

    <!-- Nơi chứa các script riêng của từng trang (sẽ học sau) -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

