<!doctype html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Tên tab thay đổi theo từng trang -->
    <title>@ViewData["Title"] - UniDoc</title>

    <!-- Link Bootstrap  -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="[https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css](https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css)" />

    @* Link CSS *@
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">

        <div class="container">

            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <i class="bi bi-journal-text fs-3 me-2"></i>
                <strong>UniDoc</strong>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>


            @* ===== Các page trên thanh menu ===== *@
            <div class="collapse navbar-collapse" id="navbarContent">

                @* Khối các page (bên trái) *@
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Course" asp-action="Index">Danh mục môn học</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Document" asp-action="Upload">Đóng góp tài liệu</a>
                    </li>
                </ul>

                @* Khối các Login/ Register (bên phải) *@
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-sm text-primary fw-bold px-3">Đăng nhập</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-sm text-primary fw-bold px-3">Đăng ký</a>
                </div>
            </div>

        </div>

    </nav>

    <!-- ================= RENDER BODY ================= -->
    <!-- Đây là nơi phần "ruột" của các trang (như Trang chủ, Đăng nhập) sẽ được nhét vào -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="bg-primary text-light py-4 mt-auto">
        <div class="container text-center">
            <p class="mb-1"><strong>Đồ án Lập trình Web - Năm 2</strong></p>
            <p class="small text-white-50 mb-0">
                Thực hiện bởi Nhóm 1 • Sử dụng ASP.NET Core MVC & Bootstrap 5
            </p>
        </div>
    </footer>

    <!-- Link JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js"></script>

    <!-- Nơi chứa các script riêng của từng trang (sẽ học sau) -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

