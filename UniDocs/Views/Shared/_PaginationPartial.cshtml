@model UniDocs.ViewModels.PaginationViewModel

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="my-5">
        <ul class="pagination justify-content-center" style="border-radius: 0.5rem; overflow: hidden;">
            
            @* Nút Previous *@
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link shadow-sm border-0 mx-1 rounded px-3" href="@string.Format(Model.UrlTemplate, Model.CurrentPage - 1)">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>

            @* In số trang *@
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link shadow-sm border-0 mx-1 rounded px-3" href="@string.Format(Model.UrlTemplate, i)">@i</a>
                </li>
            }

            @* Nút Next *@
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link shadow-sm border-0 mx-1 rounded px-3" href="@string.Format(Model.UrlTemplate, Model.CurrentPage + 1)">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>

        </ul>
    </nav>
}
