@model UniDocs.Models.Document

<a asp-controller="Document" asp-action="Detail" asp-route-id="@Model.Id" class="text-decoration-none text-dark">

    <div class="card document-card-hover h-100 position-relative overflow-hidden">

        @* Ảnh tài liệu *@
        <div class="bg-light d-flex justify-content-center align-items-center" style="height: 180px;">

            @if (!string.IsNullOrEmpty(Model.FilePath) && Model.FilePath.Contains("cloudinary.com") && Model.FilePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                var thumbnailUrl = Model.FilePath.Substring(0, Model.FilePath.Length - 4) + ".jpg";
                <img src="@thumbnailUrl" alt="@Model.Title" class="img-fluid w-100 h-100" style="object-fit: cover;" />
            }

            else if (!string.IsNullOrEmpty(Model.FilePath) && Model.FilePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                <i class="bi bi-file-earmark-pdf text-danger" style="font-size: 3.5rem;"></i>
            }

            else if (!string.IsNullOrEmpty(Model.FilePath) && (Model.FilePath.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) || Model.FilePath.EndsWith(".docx", StringComparison.OrdinalIgnoreCase)))
            {
                <i class="bi bi-file-earmark-word text-primary" style="font-size: 3.5rem;"></i>
            }

            else
            {
                <i class="bi bi-file-earmark-text text-secondary" style="font-size: 3.5rem;"></i>
            }
        </div>

        @* Thông tin Card *@
        <div class="card-body d-flex flex-column">
            
            <h5 class="card-title title-lg text-primary mb-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 3rem; line-height: 1.5rem;">
                @Model.Title
            </h5>

            <p class="card-text body-md text-muted mb-3 text-truncate">
                @Model.Course?.CourseName
            </p>

            <div class="mt-auto d-flex justify-content-between align-items-center">
                <span class="badge border border-primary text-primary bg-transparent d-flex align-items-center gap-1 px-2 py-1" style="font-size: 0.8rem;">
                    <i class="bi bi-hand-thumbs-up-fill"></i> 100%
                </span>
                <span class="text-muted small fw-medium d-flex align-items-center gap-1" style="font-size: 0.85rem;">
                    <i class="bi bi-download"></i> @Model.DownloadCount
                </span>
            </div>

        </div>

    </div>
</a>

