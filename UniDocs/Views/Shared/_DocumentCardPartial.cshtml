@model UniDocs.Models.Document

<a asp-controller="Document" asp-action="Detail" asp-route-id="@Model.Id" class="text-decoration-none text-dark">

    <div class="card h-100 shadow-sm border-0 bg-white device-card-hover position-relative rounded-4 overflow-hidden">

        @* Ảnh tài liệu *@
        <div class="bg-light d-flex justify-content-center align-items-center" style="height: 180px;">

            @if (!string.IsNullOrEmpty(Model.FilePath) && Model.FilePath.Contains("cloudinary.com") && Model.FilePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                var thumbnailUrl = Model.FilePath.Substring(0, Model.FilePath.Length - 4) + ".jpg";
                <img src="@thumbnailUrl" alt="@Model.Title" class="img-fluid w-100 h-100" style="object-fit: cover;" />
            }

            else if (!string.IsNullOrEmpty(Model.FilePath) && Model.FilePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                <i class="bi bi-file-earmark-pdf text-danger" style="font-size: 5rem;"></i>
            }

            else if (!string.IsNullOrEmpty(Model.FilePath) && (Model.FilePath.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) || Model.FilePath.EndsWith(".docx", StringComparison.OrdinalIgnoreCase)))
            {
                <i class="bi bi-file-earmark-word text-primary" style="font-size: 5rem;"></i>
            }

            else
            {
                <i class="bi bi-file-earmark-text text-secondary" style="font-size: 5rem;"></i>
            }
        </div>

        @* Thông tin Card *@
        <div class="card-body d-flex flex-column">
            
            <h5 class="card-title fs-6 fw-bold text-primary text-truncate-2-lines">
                @Model.Title
            </h5>

            <p class="card-text text-muted small mb-3">
                @Model.Course?.CourseName
            </p>

            <div class="mt-auto d-flex justify-content-between align-items-center">
                <span class="badge bg-primary-subtle text-primary border px-2 py-1">
                    <i class="bi bi-hand-thumbs-up-fill"></i> 100%
                </span>
                <span class="text-muted small">
                    @Model.DownloadCount lượt tải
                </span>
            </div>

        </div>

    </div>
</a>

