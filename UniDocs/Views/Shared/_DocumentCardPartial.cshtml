@model UniDocs.Models.Document

@* ========== Partial-View cho Card tài liệu được Upload lên ========== *@

<div class="card mb-3 border-0 shadow-sm list-item-hover position-relative">
    <div class="card-body">
        <div class="row align-items-center">

            <div class="col-auto text-center">
                <i class="bi bi-file-earmark-pdf text-danger fs-1"></i>
            </div>

            <div class="col">
                <a href="#" class="text-decoration-none text-dark fw-bold fs-5 stretched-link">@Model.Title</a>

                <div class="text-muted small mt-1">
                    <i class="bi bi-book"></i> Môn: @Model.Course?.CourseName •
                    <i class="bi bi-building"></i> @Model.User?.University
                </div>

                <div class="mt-2 text-secondary small">
                    Người đăng: <strong>@Model.User?.LastName @Model.User?.FirstName</strong> • Đăng vào @Model.UploadDate.ToString("dd/MM/yyyy")
                </div>
            </div>

            <div class="col-auto text-end d-flex flex-column gap-2 mt-3 mt-md-0">
                <a asp-controller="Document" asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary btn-sm px-3 position-relative z-3 shadow-sm rounded-pill">
                    <i class="bi bi-download"></i> Tải về (@Model.DownloadCount)
                </a>

                <button class="btn btn-light btn-sm text-success fw-bold border shadow-sm px-3 position-relative z-3 rounded-pill btn-ai-summary" data-title="@Model.Title">
                    <i class="bi bi-robot"></i> Tóm tắt AI
                </button>
            </div>

        </div>
    </div>
</div>
