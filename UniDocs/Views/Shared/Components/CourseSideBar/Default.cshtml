@model IEnumerable<UniDocs.Models.Course>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentId = ViewContext.RouteData.Values["id"]?.ToString();
    var isCourseIndex = currentController == "Course" && currentAction == "Index";
}

<div class="card border-0 shadow-sm sticky-top" style="top: 100px; z-index: 900;">
    <div class="card-header bg-white fw-bold border-bottom-0 pt-3">
        Filter by Course
    </div>

    <div class="card-body">
        <form asp-controller="Course" asp-action="SearchSidebar" method="get">
            <div class="input-group input-group-sm mb-3">
                <input type="text" name="query" class="form-control" placeholder="Search courses or docs..." />
                <button class="btn btn-primary px-3" type="submit">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </form>

        <div class="list-group list-group-flush small" style="max-height: 400px; overflow-x: hidden; overflow-y: auto;">
            <a asp-controller="Course" asp-action="Index"
               class="list-group-item list-group-item-action border-0 rounded course-sidebar-link @(isCourseIndex ? "active-course-link shadow-sm" : "")">
                All Courses
            </a>

            @foreach (var course in Model)
            {
                int docCount = course.Documents?.Count(d => d.Status == UniDocs.Models.Enums.DocumentStatusEnum.Approved) ?? 0;
                bool isActiveCourse = currentController == "Course"
                    && currentAction == "Detail"
                    && currentId == course.Id.ToString();

                <a asp-controller="Course" asp-action="Detail" asp-route-id="@course.Id"
                   class="list-group-item list-group-item-action border-0 d-flex justify-content-between align-items-center course-sidebar-link @(isActiveCourse ? "active-course-link shadow-sm" : "")">
                    <span class="text-truncate">@course.CourseName</span>
                    <span class="badge rounded-pill ms-2 @(isActiveCourse ? "bg-white text-primary" : "bg-secondary")">@docCount</span>
                </a>
            }
        </div>
    </div>
</div>
