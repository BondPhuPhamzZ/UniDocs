@{
    ViewData["Title"] = "Lỗi " + ViewBag.ErrorCode;
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="text-center p-5 bg-white shadow rounded" style="max-width: 600px;">

        <i class="bi @ViewBag.ErrorIcon" style="font-size: 6rem;"></i>

        <h1 class="display-1 fw-bold text-secondary mt-3">@ViewBag.ErrorCode</h1>

        <h3 class="mb-3 fw-bold">@ViewBag.ErrorTitle</h3>

        <p class="text-muted fs-5 mb-4">
            @ViewBag.ErrorMessage
        </p>

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4 shadow-sm rounded-pill">
            <i class="bi bi-house-door"></i> Quay về Trang chủ
        </a>
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg px-4 shadow-sm rounded-pill ms-2">
            <i class="bi bi-arrow-left"></i> Trở lại
        </a>
    </div>
</div>