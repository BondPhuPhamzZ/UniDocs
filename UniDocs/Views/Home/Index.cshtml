@model IEnumerable<UniDocs.Models.Document>
@{
    ViewData["Title"] = "Thư viện tài liệu sinh viên";
}

<!-- Khung tìm kiếm -->
<div class="bg-white border-bottom py-4 mb-4">
    <div class="container">

        <div class="row justify-content-center">

            <div class="col-md-8 text-center">

                <h2 class="h4 mb-3 text-dark">
                    Tìm kiếm tài liệu học tập, giáo trình, đề thi
                </h2>

                <form class="d-flex gap-2" action="#">
                    <input type="text" class="form-control form-control-lg shadow-sm" placeholder="Nhập tên môn học, mã môn hoặc tên tài liệu..." id="searchInput" />
                    <button class="btn btn-primary btn-lg px-4 shadow-sm" type="button" id="btnSearch">
                        <i class="bi bi-search"></i>
                    </button>
                </form>

                <div class="mt-2 text-muted small">
                    Gợi ý:
                    <a href="#" class="text-decoration-none">Nhập môn lập trình</a>,
                    <a href="#" class="text-decoration-none">Kỹ thuật lập trình</a>,
                    <a href="#" class="text-decoration-none">Cấu trúc dữ liệu và giải thuật</a>
                </div>

            </div>

        </div>

    </div>
</div>

<!-- Layout chính -->
<div class="container mb-5 flex-grow-1">
    <div class="row">

        <!-- Sidebar Lọc kết quả -> BÊN TRÁI -->
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm">
                
                <div class="card-header bg-white fw-bold border-bottom-0 pt-3">
                    Lọc tài liệu
                </div>

                <div class="card-body">

                    @* NĂM HỌC *@
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">NĂM HỌC</label>
                        <select class="form-select form-select-sm">
                            <option>Tất cả</option>
                            <option>Năm 1</option>
                            <option selected>Năm 2</option>
                            <option>Năm 3</option>
                            <option>Năm 4</option>
                        </select>
                    </div>

                    @* Loại tài liệu *@
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">LOẠI TÀI LIỆU</label>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" checked id="type1" />
                            <label class="form-check-label small" for="type1">Đề thi / Kiểm tra</label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" checked id="type2" />
                            <label class="form-check-label small" for="type2">Bài giảng / Slide</label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="type3" />
                            <label class="form-check-label small" for="type3">Bài tập lớn (BTL)</label>
                        </div>

                    </div>

                </div>

            </div>
        </div>

        <!-- ===== DANH SÁCH TÀI LIỆU (MAIN) => Khu vự hiển thị Tài liệu UPLOAD lên ===== -> BÊN PHẢI -->
        <div class="col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="m-0 fw-bold">Tài liệu mới cập nhật</h5>
                <span class="badge bg-secondary">@Model.Count() tài liệu</span>
            </div>

            @* Vòng lặp in dữ liệu động *@
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="card mb-3 border-0 shadow-sm list-item-hover position-relative">

                        <div class="card-body">

                            <div class="row align-items-center">

                                @* Cột 1 => Thay đổi icon theo DocType (tạm để PDF) *@
                                <div class="col-auto text-center">
                                    <i class="bi-file-earmark-pdf text-danger fs-1"></i>
                                </div>

                                @* Cột 2 => Thông tin tài liệu *@
                                <div class="col">
                                    <!-- In Tên tài liệu -->
                                    <a href="#" class="text-decoration-none text-dark fw-bold fs-5 stretched-link">@item.Title</a>

                                    <div class="text-muted small mt-1">
                                        @* Tên môn học *@
                                        <i class="bi bi-book"></i> Môn: @item.Course?.CourseName •
                                        @* Trường Đại học *@
                                        <i class="bi bi-building"></i> @item.User?.University
                                    </div>

                                    <div class="mt-2 text-secondary small">
                                        @* Tên người đăng và ngày tháng *@
                                        Người đăng: <strong>@item.User?.LastName @item.User?.FirstName</strong> • Đăng vào @item.UploadDate.ToString("dd/MM/yyyy")
                                    </div>
                                </div>

                                <!-- Cột 3: Nút bấm -->
                                <div class="col-auto text-end d-flex flex-column gap-2 mt-3 mt-md-0">
                                    @* Nút tải về gắn link vào FilePath *@
                                    <a href="@item.FilePath" download class="btn btn-primary btn-sm px-3 position-relative z-3 shadow-sm rounded-pill">
                                        <i class="bi bi-download"></i> Tải về (@item.DownloadCount)
                                    </a>

                                    <button class="btn btn-light btn-sm text-success fw-bold border shadow-sm px-3 position-relative z-3 rounded-pill btn-ai-summary" data-title="@item.Title">
                                        <i class="bi bi-robot"></i> Tóm tắt AI
                                    </button>
                                </div>


                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                @* Nếu DB chưa có tài liệu nào *@
                <div class="alert alert-info text-center py-5">
                    <i class="bi bi-emoji-frown fs-1 d-block mb-3"></i>
                    Hiện tại chưa có tài liệu nào được hệ thống kiểm duyệt!
                </div>
            }

        </div>

    </div>
</div>


<!-- Modal hiển thị khi click vào tài liệu để xem (Preview Modal) -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">

            <!-- Header: Màu trắng, chữ xanh đồng bộ theme -->
            <div class="modal-header border-bottom-0 pb-0">
                <h4 class="modal-title fw-bold text-primary" id="previewTitle">
                    <i class="bi bi-file-earmark-text"></i> Đề thi giữa kỳ môn Cơ sở Dữ liệu 2023
                </h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4 pt-3">
                <div class="row g-4">

                    <!-- Cột Trái: Khu vực hiển thị PDF (Chiếm 8 cột) -->
                    <div class="col-lg-8">
                        <div class="bg-light rounded d-flex flex-column align-items-center justify-content-center" style="height: 70vh; border: 2px dashed #dee2e6;">
                            <!-- ========== Thiếu iframe + đường dẫn file từ db -> <iframe src="link-pdf"></iframe> ========== -->
                            <i class="bi bi-file-earmark-pdf text-muted" style="font-size: 5rem;"></i>
                            <span class="mt-3 text-muted fw-bold">Khu vực hiển thị trước nội dung tài liệu...</span>
                        </div>
                    </div>


                    <!-- Cột Phải: Thông tin và Nút bấm (Chiếm 4 cột) -->
                    <div class="col-lg-4 d-flex flex-column">
                        <div class="mb-4">
                            <h6 class="fw-bold border-bottom pb-2 mb-3">Thông tin chi tiết</h6>
                            <p class="text-muted small mb-2">Môn học: <strong class="text-dark">Cơ sở dữ liệu</strong></p>
                            <p class="text-muted small mb-2">Trường: <strong class="text-dark">ĐH Bách Khoa HN</strong></p>
                            <p class="text-muted small mb-2">Người đăng: <strong class="text-dark">NamNguyen99</strong></p>
                            <p class="text-muted small mb-3">Ngày đăng: 15/05/2026</p>
                            <div class="bg-light p-3 rounded small text-secondary">
                                Tài liệu tổng hợp các đề thi giữa kỳ năm 2023, có kèm theo đáp án chi tiết và giải thích từng bước ở trang cuối.
                            </div>
                        </div>

                        <!-- Khu vực nút bấm đẩy xuống đáy -->
                        <div class="mt-auto d-grid gap-2">
                            <button class="btn btn-primary btn-lg fw-bold shadow-sm">
                                <i class="bi bi-download me-2"></i> Tải về miễn phí
                            </button>
                            <button class="btn btn-outline-danger fw-bold" id="btnToggleFavorite">
                                <i class="bi bi-heart me-2"></i> Thêm vào Yêu thích
                            </button>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>

</div>


<!-- Modal hiển thị kết quả AI (khi bấm vào nút Tóm tắt AI) -->
<div class="modal fade" id="aiModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white border-0">
                <h5 class="modal-title">
                    <i class="bi bi-robot"></i> AI Tóm tắt tài liệu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="aiModalBody"></div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>
