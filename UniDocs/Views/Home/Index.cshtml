@model IEnumerable<UniDocs.Models.Document>
@{
    ViewData["Title"] = "Thư viện tài liệu sinh viên";
}

@* ===== Thanh tìm kiếm ===== *@
<div class="bg-white border-bottom py-4 mb-4">
    <div class="container">

        <div class="row justify-content-center">

            <div class="col-md-8 text-center">

                <h2 class="h4 mb-3 text-dark">Tìm kiếm tài liệu học tập, giáo trình, đề thi</h2>
                <form class="d-flex gap-2" asp-controller="Home" asp-action="Index" method="get">

                    <input type="text" name="query" value="@ViewBag.SearchQuery" class="form-control form-control-lg shadow-sm" placeholder="Nhập tên môn học, hoặc tên tài liệu..." />

                    <button class="btn btn-primary btn-lg px-4 shadow-sm" type="submit">
                        <i class="bi bi-search"></i>
                    </button>

                </form>

            </div>

        </div>

    </div>
</div>


@* ===== KQua tìm kiếm ===== *@
@if (!string.IsNullOrEmpty(ViewBag.SearchQuery))
{
    <div class="mt-4 alert alert-success text-center shadow-sm">
        Tìm thấy <strong>@Model.Count()</strong> kết quả cho từ khóa: <span class="text-danger fw-bold">"@ViewBag.SearchQuery"</span>
    </div>
}

@* ===== BODY CHÍNH ===== *@
<div class="container mb-5 flex-grow-1">
    <div class="row">

        @* ===== Khu vự hiển thị Tài liệu UPLOAD lên -> BÊN PHẢI ===== *@
        <div class="col-12">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="m-0 fw-bold">Tài liệu mới cập nhật</h5>
                <span class="badge bg-secondary">@Model.Count() tài liệu</span>
            </div>

            @* ===== Khu vực hiển thị các tài liệu dc UPLOAD ===== *@
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="col">
                            <partial name="_DocumentCardPartial" model="item" />
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 alert alert-info text-center">Chưa có tài liệu nào!</div>
                }
            </div>

            @* Thanh phân trang *@
            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-5">
                    <ul class="pagination justify-content-center">

                        @* Nút Previous *@
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-query="@ViewBag.SearchQuery" asp-route-page="@(ViewBag.CurrentPage - 1)">Trước</a>
                        </li>

                        @* In số trang *@
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-query="@ViewBag.SearchQuery" asp-route-page="@i">@i</a>
                            </li>
                        }

                        @* Nút Next *@
                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-query="@ViewBag.SearchQuery" asp-route-page="@(ViewBag.CurrentPage + 1)">Sau</a>
                        </li>

                    </ul>
                </nav>
            }

        </div>

    </div>
</div>
