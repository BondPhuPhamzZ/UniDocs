@model IEnumerable<UniDocs.Models.Document>
@{
    ViewData["Title"] = "Student Document Library";
}

@* ===== HERO SECTION ===== *@
<div class="container mt-4 mb-5">
    <div class="position-relative overflow-hidden shadow-sm" style="min-height: 380px; display: flex; align-items: center; justify-content: center;">
        @* Background Image & Blur *@
        <div class="position-absolute w-100 h-100" style="background: url('/images/hero-bg.png') center/cover no-repeat; filter: blur(4px); opacity: 0.7; z-index: 0;"></div>
        <div class="position-absolute w-100 h-100" style="background: linear-gradient(to bottom, rgba(253,251,251,0.6), rgba(253,251,251,0.9)); z-index: 1;"></div>
        
        @* Content *@
        <div class="position-relative text-center px-3" style="z-index: 2;">
            <h1 class="display-lg text-primary mb-2">UniDoc</h1>
            <p class="headline-md text-dark mb-4">Academic Knowledge Base</p>
            <a asp-controller="Course" asp-action="Index" class="btn btn-primary btn-lg px-5 shadow-sm fw-bold">Explore Now</a>
        </div>
    </div>
</div>


@* ===== Search Results ===== *@
@if (!string.IsNullOrEmpty(ViewBag.SearchQuery))
{
    <div class="mt-4 alert alert-primary text-center shadow-sm">
        Found <strong>@Model.Count()</strong> results for keyword: <span class="text-danger fw-bold">"@ViewBag.SearchQuery"</span>
    </div>
}

@* ===== MAIN BODY ===== *@
<div class="container mb-5 flex-grow-1">
    <div class="row">

        @* ===== Display Uploaded Documents Section ===== *@
        <div class="col-12">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="headline-md m-0 text-primary">Recently Documents</h2>
            </div>

            @* ===== Display uploaded documents area ===== *@
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="col">
                            <partial name="_DocumentCardPartial" model="item" />
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 alert alert-info text-center">No documents yet!</div>
                }
            </div>

            @* Nút Xem thêm tài liệu *@
            @if (Model != null && Model.Count() >= 8)
            {
                <div class="text-center mt-5">
                    <a asp-controller="Course" asp-action="Index" class="btn btn-outline-primary fw-bold rounded-pill px-4">
                        View more documents <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            }

        </div>

    </div>
</div>
