@model UniDocs.ViewModels.RegisterViewModel;
@{
    ViewData["Title"] = "Đăng ký";
}
<div class="container flex-grow-1 d-flex align-items-center justify-content-center py-5">
    <div class="card border-0 shadow-sm"
         style="max-width: 500px; width: 100%">
        <div class="card-body p-4 p-md-5">

            <div class="text-center mb-4">
                <h2 class="headline-md mt-2 text-dark">Đăng ký tài khoản</h2>
                <p class="text-muted small">
                    Tham gia cộng đồng sinh viên chia sẻ tài liệu lớn nhất
                </p>
            </div>

            @* Thông báo lỗi (nếu có) *@
            <div asp-validation-summary="All" class="text-danger small fw-bold text-center mb-3"></div>

            @* ===== FORM ĐĂNG KÝ ===== *@
            <form asp-controller="Account" asp-action="Register" method="post">

                <div class="row">
                    @* Nhập tên *@
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold small text-dark">Tên</label>
                        @* <input type="text" name="firstName" class="form-control" placeholder="Tên của bạn" required /> *@
                        <input asp-for="FirstName" class="form-control" placeholder="Tên của bạn" required />
                    </div>

                    @* Nhập họ *@
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold small text-dark">Họ</label>
                        <input asp-for="LastName" class="form-control" placeholder="Họ của bạn" required />
                    </div>
                </div>

                @* Chọn trường *@
                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Trường Đại học</label>
                    <select asp-for="University" class="form-select">
                        <option value="">Chọn trường đại học...</option>
                        <option value="Đại học Ngoại ngữ - Tin học TP.HCM">Đại học Ngoại ngữ - Tin học TP.HCM</option>
                        <option value="Đại học Bách Khoa HN">Đại học Bách Khoa HN</option>
                        <option value="Đại học Khoa học Tự nhiên">Đại học Khoa học Tự nhiên</option>
                        <option value="Đại học FPT">Đại học FPT</option>
                    </select>
                </div>

                @* Nhập Email *@
                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="mssv@student.edu.vn" required />
                </div>

                @* Nhập mật khẩu *@
                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Mật khẩu</label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Tạo mật khẩu" required />
                </div>

                @* Xác nhận lại mật khầu *@
                <div class="mb-4">
                    <label class="form-label fw-bold small text-dark">Vui lòng nhập lại mật khẩu</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Xác nhận lại mật khẩu" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold py-2 mb-3">Đăng ký thành viên</button>
            </form>


            <div class="text-center mt-4 small text-muted">
                Đã có tài khoản?
                <a asp-controller="Account" asp-action="Login" class="text-primary text-decoration-none fw-bold ms-1">Đăng nhập</a>
            </div>

        </div>
    </div>
</div>


@* Validation phía Client (FE) *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}