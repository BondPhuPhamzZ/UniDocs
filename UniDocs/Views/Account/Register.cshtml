@model UniDocs.Models.User;
@{
    ViewData["Title"] = "Đăng ký";
}
<!-- Nội dung Đăng ký -->
<div class="container flex-grow-1 d-flex align-items-center justify-content-center py-5">
    <div class="card border-0 shadow-sm"
         style="max-width: 500px; width: 100%">
        <div class="card-body p-4 p-md-5">

            <div class="text-center mb-4">
                <i class="bi bi-person-plus-fill fs-1 text-primary"></i>
                <h3 class="fw-bold mt-2">Đăng ký tài khoản</h3>
                <p class="text-muted small">
                    Tham gia cộng đồng sinh viên chia sẻ tài liệu lớn nhất
                </p>
            </div>


            @* Thông báo lỗi (nếu có) *@
            <div asp-validation-summary="All" class="text-danger small fw-bold text-center mb-3"></div>


            @* @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center small fw-bold">@ViewBag.Error</div>
            } *@


            @* ===== FORM ĐĂNG KÝ ===== *@
            <form asp-controller="Account" asp-action="Register" method="post">

                <div class="row">
                    @* Nhập tên *@
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold small">Tên</label>
                        @* <input type="text" name="firstName" class="form-control" placeholder="Tên của bạn" required /> *@
                        <input asp-for="FirstName" class="form-control" placeholder="Tên của bạn" required />
                    </div>

                    @* Nhập họ *@
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold small">Họ</label>
                        <input asp-for="LastName" class="form-control" placeholder="Họ của bạn" required />
                    </div>
                </div>

                @* Chọn trường *@
                <div class="mb-3">
                    <label class="form-label fw-bold small">Trường Đại học</label>
                    <select asp-for="University" class="form-select">
                        <option value="">Chọn trường đại học...</option>
                        <option value="Đại học Ngoại ngữ - Tin học TP.HCM">Đại học Ngoại ngữ - Tin học TP.HCM</option>
                        <option value="Đại học Bách Khoa HN">Đại học Bách Khoa HN</option>
                        <option value="Đại học Khoa học Tự nhiên">Đại học Khoa học Tự nhiên</option>
                        <option value="Đại học FPT">Đại học FPT</option>
                    </select>
                </div>

                @* Nhập Email *@
                <div class="mb-3">
                    <label class="form-label fw-bold small">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="mssv@student.edu.vn" required />
                </div>

                @* Nhập mật khẩu *@
                <div class="mb-3">
                    <label class="form-label fw-bold small">Mật khẩu</label>
                    <input asp-for="PasswordHash" class="form-control" placeholder="Tạo mật khẩu" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold py-2 mb-3">Đăng ký thành viên</button>
            </form>


            <div class="text-center mt-4 small">
                Đã có tài khoản?
                <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-bold">Đăng nhập</a>
            </div>

        </div>
    </div>
</div>


@* Validation phía Client (FE) *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}