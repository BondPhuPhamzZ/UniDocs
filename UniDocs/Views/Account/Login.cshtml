@{
    ViewData["Title"] = "Đăng nhập";
}
<!-- Nội dung Đăng nhập -->
<div class="container flex-grow-1 d-flex align-items-center justify-content-center py-5">
    <div class="card border-0 shadow-sm"
         style="max-width: 400px; width: 100%">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <i class="bi bi-person-circle fs-1 text-primary"></i>
                <h3 class="fw-bold mt-2">Đăng nhập</h3>
                <p class="text-muted small">Chào mừng bạn quay lại với UniDoc!</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center small fw-bold">@ViewBag.Error</div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold small">Email đăng nhập</label>
                    <input type="email" name="email" class="form-control" placeholder="Ví dụ: admin@unidoc.com" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Mật khẩu</label>
                    <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold py-2 mb-3">Đăng nhập</button>
            </form>


            <div class="text-center mt-4 small">
                Chưa có tài khoản?
                <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-bold">Đăng ký ngay</a>
            </div>

        </div>
    </div>
</div>
