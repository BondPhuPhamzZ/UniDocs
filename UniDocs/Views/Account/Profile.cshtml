@{
    ViewData["Title"] = "Thông tin cá nhân";
}
<!-- Nội dung chính -->
<div class="container py-5 flex-grow-1">
    <div class="row">
        <!-- Cột trái: Thông tin cá nhân -->
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="bi bi-person-circle text-secondary"
                       style="font-size: 5rem"></i>
                    <h4 class="fw-bold mt-3 mb-1">Nam Nguyễn</h4>
                    <p class="text-muted small mb-3">namnguyen@student.edu.vn</p>

                    <div class="d-flex justify-content-center gap-2 mb-4">
                        <span class="badge bg-primary-subtle text-primary border"><i class="bi bi-building"></i> ĐH Bách Khoa HN</span>
                        <span class="badge bg-success-subtle text-success border"><i class="bi bi-star-fill"></i> Thành viên tích cực</span>
                    </div>

                    <div class="d-flex justify-content-between text-center border-top pt-3">
                        <div>
                            <h5 class="fw-bold text-primary mb-0">12</h5>
                            <span class="small text-muted">Tài liệu đã đăng</span>
                        </div>
                        <div>
                            <h5 class="fw-bold text-success mb-0">450</h5>
                            <span class="small text-muted">Lượt tải về</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Quản lý tài liệu đã đăng -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <!-- Bootstrap Nav Tabs -->
                    <ul class="nav nav-tabs fw-bold" id="profileTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active text-primary" id="my-docs-tab" data-bs-toggle="tab" data-bs-target="#my-docs" type="button" role="tab">
                                <i class="bi bi-folder2-open me-1"></i> Tài liệu của tôi
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link text-muted" id="favorites-tab" data-bs-toggle="tab" data-bs-target="#favorites" type="button" role="tab">
                                <i class="bi bi-heart-fill text-danger me-1"></i> Đã lưu
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-0">
                    <div class="tab-content" id="profileTabsContent">

                        <!-- TAB 1: TÀI LIỆU CỦA TÔI -->
                        <div class="tab-pane fade show active" id="my-docs" role="tabpanel">
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-file-earmark-check fs-1"></i>
                                <p class="mt-2">Danh sách tài liệu do bạn đăng tải sẽ hiện ở đây.</p>
                            </div>
                        </div>

                        <!-- TAB 2: TÀI LIỆU YÊU THÍCH -->
                        <div class="tab-pane fade" id="favorites" role="tabpanel">
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-bookmark-heart fs-1"></i>
                                <p class="mt-2">Những tài liệu bạn thả tim sẽ nằm gọn ở khu vực này.</p>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
