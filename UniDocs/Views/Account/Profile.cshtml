@model UniDocs.Models.User

@{
    ViewData["Title"] = "Trang cá nhân";
}

<div class="container py-5 flex-grow-1">
    <div class="row">

        @* ===== TRÁI: Thông tin cá nhân ===== *@
        <div class="col-lg-4 mb-5 pb-4 mb-lg-0 pb-lg-0">
            <div class="card border-0 shadow-sm sticky-lg-top" style="top: 100px; z-index: 900;">
                <div class="card-body text-center p-4">
                    <img src="https://ui-avatars.com/api/?name=@(Model.FirstName)+@(Model.LastName)&background=2A4365&color=fff&size=150" class="rounded-circle shadow-sm mb-3" alt="Avatar" />

                    <h2 class="title-lg text-dark mt-3 mb-1">@Model.LastName @Model.FirstName</h2>
                    <p class="text-muted small mb-3">@Model.Email</p>

                    @* Thống kê *@
                    <div class="d-flex justify-content-around text-center border-top pt-3">
                        <div>
                            <h5 class="fw-bold text-primary mb-0">@Model.Documents?.Count()</h5>
                            <span class="small text-muted">Đã đăng</span>
                        </div>
                        <div>
                            <h5 class="fw-bold text-danger mb-0">@Model.SavedDocuments?.Count()</h5>
                            <span class="small text-muted">Đã lưu</span>
                        </div>
                        <div>
                            <h5 class="fw-bold text-success mb-0">@(Model.Documents?.Sum(d => d.DownloadCount) ?? 0)</h5>
                            <span class="small text-muted">Lượt tải</span>
                        </div>
                    </div>

                </div>
            </div>
            
            @* Vách ngăn trên mobile *@
            <hr class="d-lg-none mt-5 text-muted border-2" />
        </div>

        @* ===== PHẢI: 2 Tab (Tài liệu đăng và Tài liệu yêu thích) ===== *@
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">

                @* Nav Tabs *@
                <div class="card-header bg-white pt-4 pb-0">
                    <ul class="nav nav-tabs card-header-tabs" id="profileTabs">

                        <li class="nav-item">
                            <button class="nav-link active fw-bold d-flex align-items-center gap-2" data-bs-toggle="tab" data-bs-target="#tab-uploaded">
                                <span>Tài liệu của tôi</span>
                                <span class="badge bg-primary">@Model.Documents?.Count()</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button class="nav-link fw-bold d-flex align-items-center gap-2" data-bs-toggle="tab" data-bs-target="#tab-saved">
                                <span>Đã lưu yêu thích</span>
                                <span class="badge bg-danger">@Model.SavedDocuments?.Count()</span>
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-0">
                    <div class="tab-content">

                        @* ===== TAB 1: Tài liệu đã đăng ===== *@
                        <div class="tab-pane fade show active" id="tab-uploaded">
                            <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                                <table class="table table-hover align-top mb-0 text-start">
                                    <thead class="table-light position-sticky top-0 shadow-sm" style="z-index: 1;">
                                    <tr>
                                        <th class="ps-4 text-nowrap">Name</th>
                                        <th class="text-nowrap">Course</th>
                                        <th class="text-nowrap">Downloads</th>
                                        <th class="pe-4 text-start text-nowrap">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Documents != null && Model.Documents.Any())
                                    {
                                        foreach (var doc in Model.Documents)
                                        {
                                            <tr>
                                                @* Hiển thị thông tin tài liệu mà User đã đăng *@
                                                <td class="ps-4 text-start">
                                                    <div class="d-flex align-items-start">
                                                        <div>
                                                            @if (doc.Status == UniDocs.Models.Enums.DocumentStatusEnum.Deleted)
                                                            {
                                                                <span class="text-decoration-none text-muted fw-bold">@doc.Title.Replace("[Đã xóa] ", "")</span>
                                                            }
                                                            else
                                                            {
                                                                <a asp-controller="Document" asp-action="Detail" asp-route-id="@doc.Id"
                                                                   class="text-decoration-none text-dark fw-bold">@doc.Title</a>
                                                            }
                                                            <div class="text-muted small">Date: @doc.UploadDate.ToString("dd/MM/yyyy")</div>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td>
                                                    <span class="fw-bold text-dark">@doc.Course?.CourseName</span>
                                                </td>

                                                <td class="fw-bold text-primary">@doc.DownloadCount</td>

                                                <td class="text-start pe-4">
                                                        <div class="d-flex justify-content-start align-items-start gap-2 flex-wrap">
                                                            @if (doc.Status == UniDocs.Models.Enums.DocumentStatusEnum.Approved)
                                                            {
                                                                <span class="fw-bold text-success mt-1">Đang hiển thị</span>
                                                            }
                                                            else if (doc.Status == UniDocs.Models.Enums.DocumentStatusEnum.Deleted)
                                                            {
                                                                <span class="fw-bold text-danger mt-1">Đã xóa</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="fw-bold text-warning mt-1">Chờ duyệt</span>
                                                            }
                                                            
                                                            @if (doc.Status != UniDocs.Models.Enums.DocumentStatusEnum.Deleted)
                                                            {
                                                                <form method="post" asp-controller="Account" asp-action="DeleteMyDocument" asp-route-id="@doc.Id" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài liệu này? Hành động này không thể hoàn tác!');">
                                                                    <button type="submit" class="btn btn-sm btn-danger" title="Xóa tài liệu">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </form>
                                                            }
                                                        </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted">
                                                Bạn chưa tải lên tài liệu nào!
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                        </div>

                        @* ===== TAB 2: Tài liệu đã lưu yêu thích ===== *@
                        <div class="tab-pane fade" id="tab-saved">
                            <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                                <table class="table table-hover align-top mb-0 text-start">
                                    <thead class="table-light position-sticky top-0 shadow-sm" style="z-index: 1;">
                                    <tr>
                                        <th class="ps-4 text-nowrap">Tên tài liệu</th>
                                        <th class="text-nowrap">Môn học</th>
                                        <th class="text-nowrap">Ngày lưu</th>
                                        <th class="pe-4 text-nowrap">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.SavedDocuments != null && Model.SavedDocuments.Any())
                                    {
                                        foreach (var saved in Model.SavedDocuments)
                                        {
                                            <tr>
                                                @* Hiển thị thông tin của các tài liệu mà User bấm lưu *@
                                                <td class="ps-4 text-start">
                                                    <div class="d-flex align-items-start">
                                                        <div>
                                                            <a asp-controller="Document" asp-action="Detail" asp-route-id="@saved.Document?.Id"
                                                               class="text-decoration-none text-dark fw-bold">
                                                                @saved.Document?.Title
                                                            </a>
                                                            <div class="text-muted small">
                                                                @saved.Document?.DownloadCount lượt tải
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td>
                                                    <span class="fw-bold text-dark">
                                                        @saved.Document?.Course?.CourseName
                                                    </span>
                                                </td>

                                                <td class="text-muted small">@saved.SavedDate.ToString("dd/MM/yyyy")</td>

                                                @* Nút bỏ lưu *@
                                                <td class="pe-4">
                                                    <form asp-controller="Document" asp-action="SaveDocument" method="post"
                                                          class="d-inline">
                                                        <input type="hidden" name="documentId" value="@saved.DocumentId" />

                                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                title="Bỏ lưu">
                                                            Bỏ lưu
                                                        </button>
                                                    </form>
                                                </td>

                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted">
                                                Bạn chưa lưu tài liệu yêu thích nào!
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>