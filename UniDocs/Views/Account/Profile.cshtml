@model UniDocs.Models.User

@{
    ViewData["Title"] = "Trang cá nhân";
}

<div class="container py-5 flex-grow-1">
    <div class="row">

        @* ===== TRÁI: Thông tin cá nhân ===== *@
        <div class="col-lg-4 mb-5 pb-4 mb-lg-0 pb-lg-0">
            <div class="card border-0 shadow-sm sticky-lg-top" style="top: 100px; z-index: 900;">
                <div class="card-body text-center p-4">
                    <img src="https://ui-avatars.com/api/?name=@(Model.FirstName)+@(Model.LastName)&background=2A4365&color=fff&size=150" class="rounded-circle shadow-sm mb-3" alt="Avatar" />

                    <h2 class="title-lg text-dark mt-3 mb-1">@Model.LastName @Model.FirstName</h2>
                    <p class="text-muted small mb-3">@Model.Email</p>

                    @* Thống kê *@
                    <div class="d-flex justify-content-around text-center border-top pt-3">
                        <div>
                            <h5 class="fw-bold text-primary mb-0">@Model.Documents?.Count()</h5>
                            <span class="small text-muted">Uploaded</span>
                        </div>
                        <div>
                            <h5 class="fw-bold text-danger mb-0">@Model.SavedDocuments?.Count()</h5>
                            <span class="small text-muted">Saved</span>
                        </div>
                        <div>
                            <h5 class="fw-bold text-primary mb-0">@(Model.Documents?.Sum(d => d.DownloadCount) ?? 0)</h5>
                            <span class="small text-muted">Downloads</span>
                        </div>
                    </div>

                    @* Buttons for Edit/Change Password *@
                    <div class="d-flex flex-column gap-2 mt-4 px-3">
                        <button class="btn btn-primary rounded-pill fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#updateProfileModal">
                            Update profile
                        </button>
                        <button class="btn btn-outline-primary rounded-pill fw-bold" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                            Change password
                        </button>
                    </div>

                </div>
            </div>
            
            @* Vách ngăn trên mobile *@
            <hr class="d-lg-none mt-5 text-muted border-2" />
        </div>

        @* ===== PHẢI: 2 Tab (Tài liệu đăng và Tài liệu yêu thích) ===== *@
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">

                @* Nav Tabs *@
                <div class="card-header bg-white pt-4 pb-0">
                    <ul class="nav nav-tabs card-header-tabs" id="profileTabs">

                        <li class="nav-item">
                            <button class="nav-link active fw-bold d-flex align-items-center gap-2" data-bs-toggle="tab" data-bs-target="#tab-uploaded">
                                <span>My docs</span>
                                <span class="fw-bold text-primary">(@Model.Documents?.Count())</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button class="nav-link fw-bold d-flex align-items-center gap-2" data-bs-toggle="tab" data-bs-target="#tab-saved">
                                <span>Favorites</span>
                                <span class="fw-bold text-danger">(@Model.SavedDocuments?.Count())</span>
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-0">
                    <div class="tab-content">

                        @* ===== TAB 1: Tài liệu đã đăng ===== *@
                        <div class="tab-pane fade show active" id="tab-uploaded">
                            <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                                <table class="table table-hover align-top mb-0 text-start">
                                    <thead class="table-light position-sticky top-0 shadow-sm" style="z-index: 1;">
                                    <tr>
                                        <th class="ps-4 text-nowrap">Name</th>
                                        <th class="text-nowrap">Course</th>
                                        <th class="text-nowrap">Downloads</th>
                                        <th class="pe-4 text-start text-nowrap">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Documents != null && Model.Documents.Any())
                                    {
                                        foreach (var doc in Model.Documents)
                                        {
                                            <tr>
                                                @* Hiển thị thông tin tài liệu mà User đã đăng *@
                                                <td class="ps-4 text-start">
                                                    <div class="d-flex align-items-start">
                                                        <div>
                                                            @if (doc.Status == UniDocs.Models.Enums.DocumentStatusEnum.Deleted)
                                                            {
                                                                <span class="text-decoration-none text-muted fw-bold">@doc.Title.Replace("[Đã xóa] ", "")</span>
                                                            }
                                                            else
                                                            {
                                                                <a asp-controller="Document" asp-action="Detail" asp-route-id="@doc.Id"
                                                                   class="text-decoration-none text-dark fw-bold">@doc.Title</a>
                                                            }
                                                            <div class="text-muted small">Date: @doc.UploadDate.ToString("dd/MM/yyyy")</div>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td>
                                                    <span class="fw-bold text-dark">@doc.Course?.CourseName</span>
                                                </td>

                                                <td class="fw-bold text-primary">@doc.DownloadCount</td>

                                                <td class="text-start pe-4">
                                                        <div class="d-flex justify-content-start align-items-start gap-2 flex-wrap">
                                                            @if (doc.Status == UniDocs.Models.Enums.DocumentStatusEnum.Approved)
                                                            {
                                                                <form method="post" asp-controller="Account" asp-action="DeleteMyDocument" asp-route-id="@doc.Id" onsubmit="return confirm('Are you sure you want to delete this document?');">
                                                                    <button type="submit" class="btn btn-sm btn-danger" title="Xóa tài liệu">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </form>
                                                            }
                                                            else if (doc.Status == UniDocs.Models.Enums.DocumentStatusEnum.Deleted)
                                                            {
                                                                <span class="fw-bold text-danger mt-1">Deleted</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="fw-bold text-warning mt-1">Pending</span>
                                                            }
                                                        </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted">
                                                You haven't uploaded any documents!
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                        </div>

                        @* ===== TAB 2: Tài liệu đã lưu yêu thích ===== *@
                        <div class="tab-pane fade" id="tab-saved">
                            <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                                <table class="table table-hover align-top mb-0 text-start">
                                    <thead class="table-light position-sticky top-0 shadow-sm" style="z-index: 1;">
                                    <tr>
                                        <th class="ps-4 text-nowrap">Course name</th>
                                        <th class="text-nowrap">Course</th>
                                        <th class="text-nowrap">Saved date</th>
                                        <th class="pe-4 text-nowrap">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.SavedDocuments != null && Model.SavedDocuments.Any())
                                    {
                                        foreach (var saved in Model.SavedDocuments)
                                        {
                                            <tr>
                                                @* Hiển thị thông tin của các tài liệu mà User bấm lưu *@
                                                <td class="ps-4 text-start">
                                                    <div class="d-flex align-items-start">
                                                        <div>
                                                            <a asp-controller="Document" asp-action="Detail" asp-route-id="@saved.Document?.Id"
                                                               class="text-decoration-none text-dark fw-bold">
                                                                @saved.Document?.Title
                                                            </a>
                                                            <div class="text-muted small">
                                                                @saved.Document?.DownloadCount
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td>
                                                    <span class="fw-bold text-dark">
                                                        @saved.Document?.Course?.CourseName
                                                    </span>
                                                </td>

                                                <td class="text-muted small">@saved.SavedDate.ToString("dd/MM/yyyy")</td>

                                                @* Nút bỏ lưu *@
                                                <td class="pe-4">
                                                    <form asp-controller="Document" asp-action="SaveDocument" method="post"
                                                          class="d-inline">
                                                        <input type="hidden" name="documentId" value="@saved.DocumentId" />

                                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                title="Bỏ lưu">
                                                            Unsaved
                                                        </button>
                                                    </form>
                                                </td>

                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted">
                                                You haven't saved any favorite documents!
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@* Modal Cập nhật thông tin *@
<div class="modal fade" id="updateProfileModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="Account" asp-action="UpdateProfile">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold">Update profile</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label fw-bold text-muted small">Last name</label>
                            <input type="text" name="LastName" class="form-control" required value="@Model.LastName" placeholder="Ex: Nguyễn Văn" />
                        </div>
                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label fw-bold text-muted small">First name</label>
                            <input type="text" name="FirstName" class="form-control" required value="@Model.FirstName" placeholder="Vd: A" />
                        </div>
                    </div>
                    <div class="mb-3 text-start">
                        <label class="form-label fw-bold text-muted small">University</label>
                        <input type="text" name="University" class="form-control" value="@Model.University" placeholder="Vd: Đại học Công nghệ thông tin" />
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal Đổi mật khẩu *@
<div class="modal fade" id="changePasswordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="Account" asp-action="ChangePassword">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold">Password change</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 text-start">
                        <label class="form-label fw-bold text-muted small">Current password</label>
                        <input type="password" name="CurrentPassword" class="form-control" required minlength="6" />
                    </div>
                    <div class="mb-3 text-start">
                        <label class="form-label fw-bold text-muted small">New password</label>
                        <input type="password" name="NewPassword" id="NewPassword" class="form-control" required minlength="6" />
                    </div>
                    <div class="mb-3 text-start">
                        <label class="form-label fw-bold text-muted small">Confirm new password</label>
                        <input type="password" name="ConfirmNewPassword" class="form-control" required minlength="6" />
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('#changePasswordModal form').addEventListener('submit', function(e) {
            const np = document.getElementById('NewPassword').value;
            const cp = document.querySelector('input[name="ConfirmNewPassword"]').value;
            if (np !== cp) {
                e.preventDefault();
                alert("The password does not match");
            }
        });
    </script>
}