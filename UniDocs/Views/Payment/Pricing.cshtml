@{
    ViewData["Title"] = "Upgrade Vip";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">Upgrade Plan</h1>
        <p class="lead text-muted">Unlock 10 free document downloads each day. Choose the package that suits you!</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Plan Card *@
    <div class="row row-cols-1 row-cols-md-3 mb-3 text-center">
        @* 1 month *@
        <div class="col">
            <div class="card mb-4 rounded-3 shadow-sm border-primary h-100">
                <div class="card-header py-3 text-white bg-primary border-primary">
                    <h4 class="my-0 fw-bold text-white">Basic VIP</h4>
                </div>
                <div class="card-body d-flex flex-column">
                    <h1 class="card-title pricing-card-title">49,000<small class="text-muted fw-light">VNĐ</small><span class="fs-5 text-muted">/month</span></h1>
                    <ul class="list-unstyled mt-3 mb-4 text-start ms-4 flex-grow-1">
                        <li><strong>Free 10 downloads</strong> / day</li>
                        <li>Downloads all documents</li>
                    </ul>
                    <a asp-controller="Payment" asp-action="CreatePayment" asp-route-planId="1" class="w-100 btn btn-lg btn-outline-primary fw-bold mt-auto">
                        Buy Now
                    </a>
                </div>
            </div>
        </div>

        <!-- 3 Months Plan (Pro) -->
        <div class="col">
            <div class="card mb-4 rounded-3 shadow-lg border-primary h-100">
                <div class="card-header py-3 text-white bg-primary border-primary position-relative">
                    <span class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-warning text-dark border border-light">
                        Popular
                    </span>
                    <h4 class="my-0 fw-bold text-white">Pro VIP</h4>
                </div>
                <div class="card-body bg-light d-flex flex-column">
                    <h1 class="card-title pricing-card-title text-primary">119,000<small class="text-muted fw-light">VNĐ</small><span class="fs-5 text-muted">/3 months</span></h1>
                    <p class="text-success fw-bold small">Save up to 28,000VNĐ</p>
                    <ul class="list-unstyled mt-3 mb-4 text-start ms-4 flex-grow-1">
                        <li><strong>Free 10 downloads</strong> / day</li>
                        <li>Downloads all documents</li>
                    </ul>
                    <a asp-controller="Payment" asp-action="CreatePayment" asp-route-planId="2" class="w-100 btn btn-lg btn-primary fw-bold shadow mt-auto">
                        Buy Now
                    </a>
                </div>
            </div>
        </div>

        <!-- 1 Year Plan -->
        <div class="col">
            <div class="card mb-4 rounded-3 shadow-sm border-primary h-100">
                <div class="card-header py-3 text-white bg-primary border-primary">
                    <h4 class="my-0 fw-normal text-white">Ultimate VIP</h4>
                </div>
                <div class="card-body d-flex flex-column">
                    <h1 class="card-title pricing-card-title">399,000<small class="text-muted fw-light">VNĐ</small><span class="fs-5 text-muted">/year</span></h1>
                    <p class="text-success fw-bold small">Save up to 189,000VNĐ</p>
                    <ul class="list-unstyled mt-3 mb-4 text-start ms-4 flex-grow-1">
                        <li><strong>Free 10 downloads</strong> / day</li>
                        <li>Download all documents</li>
                    </ul>
                    <a asp-controller="Payment" asp-action="CreatePayment" asp-route-planId="3" class="w-100 btn btn-lg btn-outline-primary fw-bold mt-auto">
                        Buy Now
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="text-center mt-4">
        <p class="text-muted small">Secure and 100% safe payment through VNPay gateway <br> <img src="https://vnpay.vn/s1/statics.vnpay.vn/2023/6/0oxhzjmxbksr1686814746087.png" alt="VNPay Logo" height="30" class="mt-2"></p>
    </div>
</div>
