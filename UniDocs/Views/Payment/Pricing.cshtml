@{
    ViewData["Title"] = "Nâng Cấp Gói VIP";
}

<div class="container py-5">
    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">Nâng Cấp Tài Khoản VIP</h1>
        <p class="lead text-muted">Mở khóa 10 lượt tải tài liệu miễn phí mỗi ngày. Chọn gói cước phù hợp với bạn!</p>
    </div>

    <!-- Alert Messages from VNPay Callback -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Pricing Cards -->
    <div class="row row-cols-1 row-cols-md-3 mb-3 text-center">
        <!-- 1 Month Plan -->
        <div class="col">
            <div class="card mb-4 rounded-3 shadow-sm border-primary">
                <div class="card-header py-3 text-white bg-primary border-primary">
                    <h4 class="my-0 fw-normal">Basic VIP</h4>
                </div>
                <div class="card-body">
                    <h1 class="card-title pricing-card-title">49,000<small class="text-muted fw-light">đ</small><span class="fs-5 text-muted">/tháng</span></h1>
                    <ul class="list-unstyled mt-3 mb-4 text-start ms-4">
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i><strong>10 lượt tải</strong> miễn phí / ngày</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Tải toàn bộ tài liệu</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Hỗ trợ đọc PDF trực tuyến</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Không giới hạn truy cập AiSummary</li>
                    </ul>
                    <a asp-controller="Payment" asp-action="CreatePayment" asp-route-planId="1" class="w-100 btn btn-lg btn-outline-primary fw-bold">
                        <i class="bi bi-qr-code-scan me-2"></i>Mua ngay 1 Tháng
                    </a>
                </div>
            </div>
        </div>

        <!-- 3 Months Plan (Pro) -->
        <div class="col">
            <div class="card mb-4 rounded-3 shadow-lg border-danger">
                <div class="card-header py-3 text-white bg-danger border-danger position-relative">
                    <span class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-warning text-dark border border-light">
                        Phổ biến nhất
                    </span>
                    <h4 class="my-0 fw-bold">Pro VIP <i class="bi bi-star-fill text-warning ms-1"></i></h4>
                </div>
                <div class="card-body bg-light">
                    <h1 class="card-title pricing-card-title text-danger">119,000<small class="text-muted fw-light">đ</small><span class="fs-5 text-muted">/3 tháng</span></h1>
                    <p class="text-success fw-bold small"><i class="bi bi-tag-fill me-1"></i>Tiết kiệm 28,000đ</p>
                    <ul class="list-unstyled mt-3 mb-4 text-start ms-4">
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i><strong>10 lượt tải</strong> miễn phí / ngày</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Tải toàn bộ tài liệu</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Hỗ trợ đọc PDF trực tuyến</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Không giới hạn truy cập AiSummary</li>
                    </ul>
                    <a asp-controller="Payment" asp-action="CreatePayment" asp-route-planId="2" class="w-100 btn btn-lg btn-danger fw-bold shadow">
                        <i class="bi bi-qr-code-scan me-2"></i>Mua ngay 3 Tháng
                    </a>
                </div>
            </div>
        </div>

        <!-- 1 Year Plan -->
        <div class="col">
            <div class="card mb-4 rounded-3 shadow-sm border-primary">
                <div class="card-header py-3 text-white bg-primary border-primary">
                    <h4 class="my-0 fw-normal">Ultimate VIP</h4>
                </div>
                <div class="card-body">
                    <h1 class="card-title pricing-card-title">399,000<small class="text-muted fw-light">đ</small><span class="fs-5 text-muted">/năm</span></h1>
                    <p class="text-success fw-bold small"><i class="bi bi-tag-fill me-1"></i>Tiết kiệm 189,000đ</p>
                    <ul class="list-unstyled mt-3 mb-4 text-start ms-4">
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i><strong>10 lượt tải</strong> miễn phí / ngày</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Tải toàn bộ tài liệu</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Hỗ trợ đọc PDF trực tuyến</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Không giới hạn truy cập AiSummary</li>
                    </ul>
                    <a asp-controller="Payment" asp-action="CreatePayment" asp-route-planId="3" class="w-100 btn btn-lg btn-outline-primary fw-bold">
                        <i class="bi bi-qr-code-scan me-2"></i>Mua ngay 1 Năm
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Info VNPay -->
    <div class="text-center mt-4">
        <p class="text-muted small">Thanh toán an toàn, bảo mật 100% qua cổng VNPay <br> <img src="https://vnpay.vn/s1/statics.vnpay.vn/2023/6/0oxhzjmxbksr1686814746087.png" alt="VNPay Logo" height="30" class="mt-2"></p>
    </div>
</div>
