@{
    ViewData["Title"] = "Danh mục môn học";
}
<!-- Header Danh mục -->
<div class="bg-white border-bottom py-4 mb-4">
    <div class="container">
        <div class="row align-items-center">

            @* Tên tiêu đề -> BÊN TRÁI *@
            <div class="col-md-6">
                <h2 class="h3 mb-1 text-dark">Danh mục Môn học</h2>
                <p class="text-muted mb-0">
                    Duyệt tài liệu theo từng môn học cụ thể
                </p>
            </div>

            @* Thanh lọc môn -> BÊN PHẢI *@
            <div class="col-md-6 mt-3 mt-md-0">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text"
                           class="form-control border-start-0"
                           placeholder="Lọc nhanh tên môn..." />
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Nội dung Môn học -->
<div class="container mb-5 flex-grow-1">

    <div class="row g-4">

        <!-- Course Card 1 -->
        <div class="col-md-4 col-sm-6">
            <!-- Thêm position-relative để card thành link -->
            <div class="card h-100 border-0 shadow-sm list-item-hover position-relative">
                <div class="card-body d-flex flex-column">

                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-primary">CNTT</span>
                        <span class="text-muted small">Mã: IT101</span>
                    </div>

                    <!-- stretched-link phủ toàn bộ card -->
                    <h5 class="card-title fw-bold mt-2 mb-3">
                        <a asp-controller="Course" asp-action="Detail" class="text-decoration-none text-dark stretched-link">Nhập môn lập trình</a>
                    </h5>

                    <p class="card-text text-muted small mb-auto">
                        Học kỳ 1 - Đại học Bách Khoa HN
                    </p>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">

                        <div class="text-secondary small fw-bold">
                            <i class="bi bi-files text-primary me-1"></i> 124 Tài liệu
                        </div>

                        <span class="text-secondary small opacity-75 fw-medium">
                            Truy cập <i class="bi bi-arrow-right"></i>
                        </span>

                    </div>

                </div>
            </div>
        </div>

        <!-- Course Card 2 -->
        <div class="col-md-4 col-sm-6">
            <div class="card h-100 border-0 shadow-sm list-item-hover position-relative">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-success">Cơ bản</span>
                        <span class="text-muted small">Mã: MI1010</span>
                    </div>
                    <h5 class="card-title fw-bold mt-2 mb-3">
                        <a asp-controller="Course" asp-action="Detail" class="text-decoration-none text-dark stretched-link"> Giải tích 1</a>
                    </h5>
                    <p class="card-text text-muted small mb-auto">
                        Học kỳ 1 - Đại học Khoa học Tự nhiên
                    </p>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <div class="text-secondary small fw-bold">
                            <i class="bi bi-files text-primary me-1"></i> 340 Tài liệu
                        </div>
                        <span class="text-secondary small opacity-75 fw-medium">
                            Truy cập <i class="bi bi-arrow-right"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Course Card 3 -->
        <div class="col-md-4 col-sm-6">
            <div class="card h-100 border-0 shadow-sm list-item-hover position-relative">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-primary">CNTT</span>
                        <span class="text-muted small">Mã: IT202</span>
                    </div>
                    <h5 class="card-title fw-bold mt-2 mb-3">
                        <a asp-controller="Course" asp-action="Detail" class="text-decoration-none text-dark stretched-link">Cấu trúc Dữ liệu và Giải thuật</a>
                    </h5>
                    <p class="card-text text-muted small mb-auto">
                        Học kỳ 3 - Học viện Bưu chính Viễn thông
                    </p>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <div class="text-secondary small fw-bold">
                            <i class="bi bi-files text-primary me-1"></i> 89 Tài liệu
                        </div>
                        <span class="text-secondary small opacity-75 fw-medium">
                            Truy cập <i class="bi bi-arrow-right"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Course Card 4 -->
        <div class="col-md-4 col-sm-6">
            <div class="card h-100 border-0 shadow-sm list-item-hover position-relative">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-warning text-dark">Kinh tế</span>
                        <span class="text-muted small">Mã: EC101</span>
                    </div>
                    <h5 class="card-title fw-bold mt-2 mb-3">
                        <a asp-controller="Course" asp-action="Detail" class="text-decoration-none text-dark stretched-link">Kinh tế vĩ mô</a>
                    </h5>
                    <p class="card-text text-muted small mb-auto">
                        Học kỳ 2 - Đại học Kinh tế Quốc dân
                    </p>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <div class="text-secondary small fw-bold">
                            <i class="bi bi-files text-primary me-1"></i> 210 Tài liệu
                        </div>
                        <span class="text-secondary small opacity-75 fw-medium">
                            Truy cập <i class="bi bi-arrow-right"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>