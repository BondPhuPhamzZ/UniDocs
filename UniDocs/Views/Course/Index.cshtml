@model IEnumerable<UniDocs.Models.Course>
@{
    ViewData["Title"] = "Course Categories";
}
<div class="bg-white border-bottom py-4 mb-4 sticky-top shadow-sm" style="top: 56px; z-index: 990;">
    <div class="container">
        <div class="row align-items-center">

            @* Tên tiêu đề *@
            <div class="col-md-6">
                <h2 class="headline-md mb-1 text-dark">Course Categories</h2>
                <p class="text-muted mb-0">
                    Browse documents by specific courses
                </p>
            </div>

        </div>
    </div>
</div>


@* ===== Khu vực hiển thị các môn học của Web ===== *@
<div class="container mb-5 flex-grow-1">

    @* Course List *@
    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <partial name="_CourseCardPartial" model="item" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="col-12 alert alert-info text-center">No courses yet!</div>
    }


    @* Thanh phân trang *@
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="my-5">
            <ul class="pagination justify-content-center" style="border-radius: 0.5rem; overflow: hidden;">

                @* Nút Previous *@
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link px-3" asp-action="Index" asp-route-query="@ViewBag.SearchQuery" asp-route-page="@(ViewBag.CurrentPage - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @* In số trang *@
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link px-3" asp-action="Index" asp-route-query="@ViewBag.SearchQuery" asp-route-page="@i">@i</a>
                    </li>
                }

                @* Nút Next *@
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link px-3" asp-action="Index" asp-route-query="@ViewBag.SearchQuery" asp-route-page="@(ViewBag.CurrentPage + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>

            </ul>
        </nav>
    }

</div>