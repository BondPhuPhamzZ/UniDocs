@model IEnumerable<UniDocs.Models.Course>
@{
    ViewData["Title"] = "Danh mục môn học";
}
<div class="bg-white border-bottom py-4 mb-4">
    <div class="container">
        <div class="row align-items-center">

            @* Tên tiêu đề *@
            <div class="col-md-6">
                <h2 class="h3 mb-1 text-dark">Danh mục Môn học</h2>
                <p class="text-muted mb-0">
                    Duyệt tài liệu theo từng môn học cụ thể
                </p>
            </div>

            @* Thanh tìm kiếm môn -> TRÊN CÙNG *@
            <div class="col-md-6 mt-3 mt-md-0">
                <form asp-controller="Course" asp-action="Index" method="get">
                    <div class="input-group">

                        <button class="btn input-group-text bg-light border-end-0" type="submit">
                            <i class="bi bi-search text-primary"></i>
                        </button>

                        <input type="text" name="query" value="@ViewBag.SearchQuery" class="form-control border-start-0" placeholder="Lọc nhanh tên môn..." />

                    </div>
                </form>

                @* Thông báo tìm kiếm *@
                @if (!string.IsNullOrEmpty(ViewBag.SearchQuery))
                {
                    <div class="alert alert-success mb-4">
                        Tìm thấy kết quả cho: <strong>"@ViewBag.SearchQuery"</strong>
                        <a asp-controller="Course" asp-action="Index" class="text-danger text-decoration-none ms-3">Xóa bộ lọc</a>
                    </div>
                }

            </div>

        </div>
    </div>
</div>


@* ===== Khu vực hiển thị các môn học của Web ===== *@
<div class="container mb-5 flex-grow-1">

    <div class="row g-4">

        @* Các môn học *@
        @foreach (var item in Model)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card h-100 border-0 shadow-sm list-item-hover position-relative">
                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-success">@item.Department</span>
                        </div>

                        @* Tên môn học *@
                        <h5 class="card-title fw-bold mt-2 mb-3">
                            <a asp-controller="Course" asp-action="Detail" asp-route-id="@item.Id" class="text-decoration-none text-dark stretched-link">@item.CourseName</a>
                        </h5>

                        @* Số tài liệu của môn *@
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">

                            <div class="text-secondary small fw-bold">
                                <i class="bi bi-files text-primary me-1"></i> @item.Documents?.Count() Tài liệu
                            </div>

                            <span class="text-secondary small opacity-75 fw-medium">
                                Truy cập <i class="bi bi-arrow-right"></i>
                            </span>

                        </div>

                    </div>
                </div>
            </div>
        }

    </div>

</div>