@model IEnumerable<UniDocs.Models.Document>

@{
    ViewData["Title"] = "Cours detail " + ViewBag.CourseName;
}

<div class="bg-white border-bottom py-3 mb-4">
    <div class="container">

        @* Header ngành *@
        <div class="d-flex justify-content-between align-items-end">

            <div>
                <h2 class="headline-md mb-1 text-dark">Course: @ViewBag.CourseName</h2>
                <p class="text-muted mb-0">
                    Department: @ViewBag.Department
                </p>
            </div>

        </div>

    </div>
</div>


@* ===== MAIN CONTENT ===== *@
<div class="container mb-5 flex-grow-1">
    <div class="row">

        @* === Sidebar TRÁI lọc môn học === *@
        <div class="col-lg-3 mb-4">
            <vc:course-sidebar></vc:course-sidebar>
        </div>

        @* === Khu vực các tài liệu thuộc môn học đó hiển thị (PHẢI) === *@
        <div class="col-lg-9">

            @if (!string.IsNullOrEmpty(ViewBag.DocQuery as string))
            {
                <div class="alert alert-success shadow-sm mb-4">
                    Showing documents containing keyword: <strong>"@ViewBag.DocQuery"</strong>
                </div>
            }

            @if (Model != null && Model.Any())
            {
                @* Hiển thị các tài liệu *@
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col">
                            <partial name="_DocumentCardPartial" model="item" />
                        </div>
                    }
                </div>

                @* Thanh phân trang *@
                <partial name="_PaginationPartial" model="@(new UniDocs.ViewModels.PaginationViewModel { CurrentPage = ViewBag.CurrentPage ?? 1, TotalPages = ViewBag.TotalPages ?? 1, UrlTemplate = Url.Action("Detail", new { id = ViewBag.CourseId, docQuery = ViewBag.DocQuery, page = "{0}" })?.Replace("%7B0%7D", "{0}") })" />

            }
            else
            {
                <div class="alert alert-primary bg-primary-subtle text-primary border-primary-subtle text-center py-5 shadow-sm rounded-3">
                    <h5 class="title-lg text-dark mb-3">No documents yet</h5>
                    <p class="mb-0">This course doesn't have any documents yet. Be the first to contribute!</p>
                </div>
            }

        </div>

    </div>
</div>
