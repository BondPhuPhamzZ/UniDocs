@model IEnumerable<UniDocs.Models.Document>

@{
    ViewData["Title"] = "Cours detail " + ViewBag.CourseName;
}

<div class="bg-white border-bottom py-3 mb-4">
    <div class="container">

        @* Header ngành *@
        <div class="d-flex justify-content-between align-items-end">

            <div>
                <h2 class="headline-md mb-1 text-dark">Course: @ViewBag.CourseName</h2>
                <p class="text-muted mb-0">
                    Department: @ViewBag.Department
                </p>
            </div>

            <div class="text-end d-none d-md-block">
                @ViewBag.TotalDocuments Tài liệu
            </div>

        </div>

    </div>
</div>


@* ===== MAIN CONTENT ===== *@
<div class="container mb-5 flex-grow-1">
    <div class="row">

        @* === Sidebar TRÁI lọc môn học === *@
        <div class="col-lg-3 mb-4">
            <vc:course-sidebar></vc:course-sidebar>
        </div>

        @* === Khu vực các tài liệu thuộc môn học đó hiển thị (PHẢI) === *@
        <div class="col-lg-9">

            @if (!string.IsNullOrEmpty(ViewBag.DocQuery as string))
            {
                <div class="alert alert-success shadow-sm mb-4">
                    Đang hiển thị tài liệu chứa từ khóa: <strong>"@ViewBag.DocQuery"</strong>
                </div>
            }

            @if (Model != null && Model.Any())
            {
                @* Hiển thị các tài liệu *@
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col">
                            <partial name="_DocumentCardPartial" model="item" />
                        </div>
                    }
                </div>

                @* Thanh phân trang *@
                <nav aria-label="Page navigation" class="my-5">
                    <ul class="pagination justify-content-center" style="border-radius: 0.5rem; overflow: hidden;">

                        @* Nút Previous *@
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link px-3" asp-action="Detail" asp-route-id="@ViewBag.CourseId" asp-route-docQuery="@ViewBag.DocQuery" asp-route-page="@(ViewBag.CurrentPage - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @* In số trang *@
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link px-3" asp-action="Detail" asp-route-id="@ViewBag.CourseId" asp-route-docQuery="@ViewBag.DocQuery" asp-route-page="@i">@i</a>
                            </li>
                        }

                        @* Nút Next *@
                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link px-3" asp-action="Detail" asp-route-id="@ViewBag.CourseId" asp-route-docQuery="@ViewBag.DocQuery" asp-route-page="@(ViewBag.CurrentPage + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>

                    </ul>
                </nav>

            }
            else
            {
                <div class="alert alert-primary bg-primary-subtle text-primary border-primary-subtle text-center py-5 shadow-sm rounded-3">
                    <h5 class="title-lg text-dark mb-3">Chưa có tài liệu nào</h5>
                    <p class="mb-0">Môn học này hiện chưa có tài liệu. Hãy là người đầu tiên đóng góp tài liệu nhé!</p>
                </div>
            }

        </div>

    </div>
</div>
