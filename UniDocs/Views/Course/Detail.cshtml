@model UniDocs.Models.Course

@{
    ViewData["Title"] = "Chi tiết môn: " + Model.CourseName;
}
<!-- Breadcrumb & Header Ngành -->
<div class="bg-white border-bottom py-3 mb-4">
    <div class="container">

        @* Breadcumb => Hiện tại đang ở đâu *@
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small">

                <li class="breadcrumb-item">
                    <a href="/" class="text-decoration-none">Trang chủ</a>
                </li>

                <li class="breadcrumb-item">
                    <a asp-controller="Course" asp-action="Index" class="text-decoration-none">Danh mục môn học</a>
                </li>

                <li class="breadcrumb-item active" aria-current="page">
                    @Model.CourseName
                </li>

            </ol>
        </nav>

        @* Header ngành *@
        <div class="d-flex justify-content-between align-items-end">

            <div>
                <h2 class="h3 mb-1 text-dark fw-bold">Môn: @Model.CourseName</h2>
                <p class="text-muted mb-0">
                    Thuộc khoa: @Model.Department
                </p>
            </div>

            <div class="text-end d-none d-md-block">
                <span class="badge bg-primary fs-6 py-2 px-3">@Model.Documents?.Count() Tài liệu</span>
            </div>

        </div>

    </div>
</div>


@* ===== MAIN CONTENT ===== *@
<div class="container mb-5 flex-grow-1">
    <div class="row">

        @* === Sidebar trái lọc môn học === *@
        <div class="col-lg-3 mb-4">
            <vc:course-sidebar></vc:course-sidebar>
        </div>

        @* === Các tài liệu thuộc môn học đó === *@
        <div class="col-lg-9">

            @if(Model.Documents != null && Model.Documents.Any())
            {
                foreach (var doc in Model.Documents)
                {
                    <partial name="_DocumentCardPartial" model="doc" />
                }
            }
            else
            {
                <div class="alert alert-info text-center py-5">
                    <i class="bi bi-folder-x fs-1 d-block mb-3"></i>
                    Chưa có tài liệu nào cho môn học này! Trở thành người đầu tiên đóng góp ngay nhé.
                </div>
            }

        </div>

    </div>
</div>
