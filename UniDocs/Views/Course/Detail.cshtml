@model IEnumerable<UniDocs.Models.Document>

@{
    ViewData["Title"] = "Chi tiết môn: " + ViewBag.CourseName;
}

<div class="bg-white border-bottom py-3 mb-4">
    <div class="container">

        @* Header ngành *@
        <div class="d-flex justify-content-between align-items-end">

            <div>
                <h2 class="h3 mb-1 text-dark fw-bold">Môn: @ViewBag.CourseName</h2>
                <p class="text-muted mb-0">
                    Thuộc khoa: @ViewBag.Department
                </p>
            </div>

            <div class="text-end d-none d-md-block">
                <span class="badge bg-primary fs-6 py-2 px-3">@ViewBag.TotalDocuments Tài liệu</span>
            </div>

        </div>

    </div>
</div>


@* ===== MAIN CONTENT ===== *@
<div class="container mb-5 flex-grow-1">
    <div class="row">

        @* === Sidebar TRÁI lọc môn học === *@
        <div class="col-lg-3 mb-4">
            <vc:course-sidebar></vc:course-sidebar>
        </div>

        @* === Khu vực các tài liệu thuộc môn học đó hiển thị (PHẢI) === *@
        <div class="col-lg-9">

            @if (!string.IsNullOrEmpty(ViewBag.DocQuery as string))
            {
                <div class="alert alert-success shadow-sm mb-4">
                    Đang hiển thị tài liệu chứa từ khóa: <strong>"@ViewBag.DocQuery"</strong>
                    <a asp-action="Detail" asp-route-id="@ViewBag.CourseId" class="text-danger text-decoration-none ms-3">Xóa lọc</a>
                </div>
            }

            @if (Model != null && Model.Any())
            {
                @* Hiển thị các tài liệu *@
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <div class="col">
                                <partial name="_DocumentCardPartial" model="item" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 alert alert-info text-center">Chưa có tài liệu nào!</div>
                    }
                </div>

                @* Thanh phân trang *@
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">

                        @* Nút Previous *@
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Detail" asp-route-id="@ViewBag.CourseId" asp-route-docQuery="@ViewBag.DocQuery" asp-route-page="@(ViewBag.CurrentPage - 1)">Trước</a>
                        </li>

                        @* In số trang *@
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Detail" asp-route-id="@ViewBag.CourseId" asp-route-docQuery="@ViewBag.DocQuery" asp-route-page="@i">@i</a>
                            </li>
                        }

                        @* Nút Next *@
                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Detail" asp-route-id="@ViewBag.CourseId" asp-route-docQuery="@ViewBag.DocQuery" asp-route-page="@(ViewBag.CurrentPage + 1)">Sau</a>
                        </li>

                    </ul>
                </nav>

            }
            else
            {
                <div class="alert alert-info text-center py-5">Chưa có tài liệu nào cho môn học này!</div>
            }

        </div>

    </div>
</div>
