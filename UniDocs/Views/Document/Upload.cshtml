@{
    ViewData["Title"] = "Đăng tải tài liệu";
}
<!-- Nội dung Đóng góp tài liệu -->
<div class="container flex-grow-1 py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center mb-4">
                <i class="bi bi-cloud-arrow-up fs-2 text-primary me-3"></i>
                <div>
                    <h2 class="h3 mb-0 fw-bold">Đóng góp Tài liệu</h2>
                    <p class="text-muted mb-0 small">
                        Chia sẻ tài liệu của bạn để giúp đỡ cộng đồng sinh viên.
                    </p>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form>
                        <!-- Kéo thả File (Giao diện giả lập) -->
                        <div class="mb-4">
                            <label class="form-label fw-bold small">Chọn file tải lên</label>
                            <div class="border border-2 border-dashed rounded bg-light text-center p-5"
                                 style="border-style: dashed !important; border-color: #dee2e6 !important;">
                                <i class="bi bi-file-earmark-arrow-up fs-1 text-muted mb-2"></i>
                                <h5>Kéo thả file vào đây</h5>
                                <p class="text-muted small mb-3">
                                    Hỗ trợ định dạng: PDF, DOCX, PPTX (Tối đa 50MB)
                                </p>
                                <input type="file" class="d-none" id="fileUpload" />
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        onclick="document.getElementById('fileUpload').click()">
                                    Hoặc Chọn từ máy tính
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="docTitle" class="form-label fw-bold small">Tên tài liệu <span class="text-danger">*</span></label>
                            <input type="text"
                                   class="form-control"
                                   id="docTitle"
                                   placeholder="Ví dụ: Đề thi giữa kỳ môn Cơ sở dữ liệu 2023" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="university" class="form-label fw-bold small">Trường Đại học <span class="text-danger">*</span></label>
                                <select class="form-select" id="university">
                                    <option value="">Chọn trường...</option>
                                    <option value="1">Đại học Ngoại ngữ - Tin học</option>
                                    <option value="1">Đại học Bách Khoa HN</option>
                                    <option value="2">Đại học FPT</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="course" class="form-label fw-bold small">Môn học <span class="text-danger">*</span></label>
                                <select class="form-select" id="course">
                                    <option value="">Chọn môn học...</option>
                                    <option value="1">Cơ sở dữ liệu</option>
                                    <option value="2">Nhập môn Lập trình</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="docType" class="form-label fw-bold small">Loại tài liệu</label>
                                <select class="form-select" id="docType">
                                    <option>Đề thi / Kiểm tra</option>
                                    <option>Bài giảng / Slide</option>
                                    <option>Bài tập lớn</option>
                                    <option>Tóm tắt / Đề cương ôn tập</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="docYear" class="form-label fw-bold small">Năm học</label>
                                <input type="text"
                                       class="form-control"
                                       id="docYear"
                                       placeholder="Ví dụ: 2023-2024" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="docDescription" class="form-label fw-bold small">Mô tả thêm (Tùy chọn)</label>
                            <textarea class="form-control"
                                      id="docDescription"
                                      rows="3"
                                      placeholder="Ghi chú thêm về tài liệu (VD: Đề thi có đáp án chi tiết ở trang cuối...)"></textarea>
                        </div>

                        <div class="alert alert-warning small mb-4">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> Tài liệu
                            sẽ được Admin duyệt trước khi hiển thị công khai để đảm bảo
                            chất lượng.
                        </div>

                        <div class="text-end">
                            <a href="index.html" class="btn btn-light me-2">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold">
                                <i class="bi bi-cloud-upload me-1"></i> Gửi Tài Liệu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
