@model UniDocs.Models.Document;
@{
    ViewData["Title"] = "Upload Document";
}
<div class="container flex-grow-1 py-4 py-md-5 upload-page">
    <div class="row justify-content-center g-0">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7">

            <div class="d-flex align-items-start gap-3 mb-4">
                <div class="min-w-0">
                    <h2 class="headline-md mb-0">Upload a Document</h2>
                    <p class="text-muted mb-0 small">
                        Share your documents to help the student community.
                    </p>
                </div>
            </div>


            <div class="card border-0 shadow-sm upload-card">
                <div class="card-body p-3 p-md-4">

                    @* Lỗi -> (nếu có) *@
                    <div asp-validation-summary="All" class="text-danger small fw-bold text-center mb-3"></div>

                    @* ===== Form Upload tài liệu ===== *@
                    <form asp-controller="Document" asp-action="Upload" method="post" enctype="multipart/form-data">

                        @* Chọn file muốn up có định dạng phù hợp *@
                        <div class="mb-4">
                            <label class="form-label fw-bold small">Select file to upload <span class="text-danger">*</span></label>
                            <div class="border border-2 border-dashed rounded bg-light text-center upload-dropzone">
                                <h5 class="title-lg mb-1">Click to select file</h5>
                                <p class="text-muted small mb-3">Supported formats: PDF, DOCX, PPTX, ZIP, RAR (Max 50MB)</p>

                                <input type="file" name="uploadedFile" class="form-control" accept=".pdf,.doc,.docx,.ppt,.pptx,.zip,.rar" required />
                            </div>
                        </div>

                        @* Nhập tên tài liệu *@
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Document title <span class="text-danger">*</span></label>
                            @* <input type="text" name="Title" class="form-control" placeholder="Ví dụ: Đề thi giữa kỳ môn Cơ sở dữ liệu 2023" required /> *@
                            <input asp-for="Title" class="form-control" placeholder="E.g: Database Midterm Exam" required />
                        </div>

                        @* Chọn môn *@
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold small">Course <span class="text-danger">*</span></label>
                                <select asp-for="CourseId" class="form-select" required>
                                    <option value="">Select course...</option>
                                    @if (ViewBag.Courses != null)
                                    {
                                        foreach (var course in ViewBag.Courses)
                                        {
                                            <option value="@course.Id">@course.CourseName (@course.CourseCode)</option>
                                        }
                                    }
                                </select>
                            </div>

                            @* Chọn loại tài liệu *@
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold small">Document type</label>
                                <select asp-for="DocType" class="form-select">
                                    <option value="Đề thi / Kiểm tra">Exam / Test</option>
                                    <option value="Bài giảng / Slide">Lecture / Slide</option>
                                    <option value="Bài tập lớn">Assignment / Project</option>
                                    <option value="Khác">Other</option>
                                </select>
                            </div>

                        </div>

                        @* Năm học *@
                        <div class="mt-3 mb-3">
                            <label class="form-label fw-bold small">Academic year</label>
                            <input asp-for="AcademicYear" class="form-control" placeholder="E.g: 2023-2024" />
                        </div>

                        @* Mô tả thêm cho tài liệu *@
                        <div class="mb-4">
                            <label class="form-label fw-bold small">Additional description (Optional)</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Add notes about the document..."></textarea>
                        </div>

                        @* Button gửi tlieu *@
                        <div class="d-grid d-sm-flex justify-content-sm-end">
                            <button type="submit" class="btn btn-primary px-4 fw-bold">
                                Submit
                            </button>
                        </div>

                    </form>

                </div>

            </div>
        </div>
    </div>
</div>
