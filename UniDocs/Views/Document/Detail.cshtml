@model UniDocs.Models.Document
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <div class="row g-4">
        
        @* ===== CONTENT: LEFT COLUMN ===== *@
        <div class="col-12 col-lg-8 d-flex flex-column gap-4">
            
            @* Thông tin tài liệu *@
            <div class="card border-0 shadow-sm p-4">
                <h2 class="headline-md text-dark mb-3">
                    @Model.Title
                </h2>
                
                <div class="d-flex flex-wrap gap-4 text-muted small mb-3">
                    <span>
                        <span class="fw-bold text-dark">Course: </span>
                        <a asp-controller="Course" asp-action="Detail" asp-route-id="@Model.CourseId" class="text-decoration-underline text-primary fw-bold">
                            @Model.Course?.CourseName
                        </a>
                    </span>
                    <span><span class="fw-bold text-dark">Year: </span> @Model.AcademicYear</span>
                    <span><span class="fw-bold text-dark">Type: </span> @Model.DocType</span>
                </div>

                <div class="small text-muted">
                    <span>
                        <span class="fw-bold text-dark">User: </span>
                        <a asp-controller="Account" asp-action="PublicProfile" asp-route-id="@Model.UserId" class="text-decoration-underline text-primary fw-bold">
                            @Model.User?.LastName @Model.User?.FirstName
                        </a> <br />
                    </span>
                    Upload date: @Model.UploadDate.ToString("dd/MM/yyyy")
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="mt-3 small mb-0 text-dark border-start border-3 border-primary ps-2">@Model.Description</p>
                }
            </div>

            @* Khu vực đọc PDF *@
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
                    <h6 class="mb-0 fw-bold text-light">Content</h6>
                    <a href="@Model.FilePath" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3">
                        Full screen
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.Status == UniDocs.Models.Enums.DocumentStatusEnum.Deleted)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-file-earmark-x display-4"></i>
                            <h5 class="mt-3">The document has been removed!</h5>
                            <p>The physical file of this document has been deleted from the server!</p>
                        </div>
                    }
                    else
                    {
                        <iframe src="@Model.FilePath" width="100%" height="900px" style="border: none; display: block;">
                            Your browser does not support direct document viewing.
                        </iframe>
                    }
                </div>
            </div>

        </div>

        @* ===== BUTTONS: RIGHT COLUMN ===== *@
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm p-4 sticky-lg-top" style="top: 80px; z-index: 990;">
                
                @* Hàng nút Icon *@
                <div class="d-flex justify-content-between gap-2 mb-3">
                    
                    @* Nút Download *@
                    <div class="d-flex gap-2">
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Document" asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary fw-bold rounded flex-grow-1">
                                <i class="bi bi-download me-2"></i>Download
                            </a>
                        }
                        else if (ViewBag.UserCredits <= 0)
                        {
                            <button type="button" class="btn btn-primary fw-bold rounded flex-grow-1" data-bs-toggle="modal" data-bs-target="#outOfCreditsModal">
                                <i class="bi bi-download me-2"></i>Download
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Document" asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary fw-bold rounded flex-grow-1">
                                <i class="bi bi-download me-2"></i>Download
                                <span class="badge bg-light text-primary ms-1">-1 Credit</span>
                            </a>
                        }
                    </div>

                    @* Nút Yêu thích (Trái tim) *@
                    <form asp-controller="Document" asp-action="SaveDocument" method="post" class="flex-grow-1 d-flex">
                        <input type="hidden" name="documentId" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger fw-bold rounded w-100" title="Thêm vào yêu thích">
                            <i class="bi bi-heart-fill"></i>
                        </button>
                    </form>

                    @* Nút Báo cáo (Lá cờ) *@
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <button type="button" class="btn btn-outline-primary fw-bold rounded flex-grow-1" data-bs-toggle="collapse" data-bs-target="#reportForm" title="Báo cáo tài liệu" onclick="this.blur()">
                            <i class="bi bi-flag-fill"></i>
                        </button>
                    }
                </div>

                @* Form Báo cáo (Collapse) *@
                @if (User.Identity!.IsAuthenticated)
                {
                    <div class="collapse mb-3 text-start" id="reportForm">
                        <form asp-action="Report" asp-controller="Document" method="post">
                            <input type="hidden" name="DocumentId" value="@Model.Id" />
                            <select name="Reason" class="form-select form-select-sm mb-2">
                                <option>Incorrect content</option>
                                <option>Copyright violated</option>
                                <option>The document cannot be opened</option>
                                <option>Not suitable content</option>
                            </select>
                            <button type="submit" class="btn btn-danger btn-sm w-100">Send</button>
                        </form>
                    </div>
                }

                @* Nút Tóm tắt AI *@
                <button id="btnAiSummary" onclick="loadAiSummary(@Model.Id)" class="btn btn-outline-primary fw-bold rounded-pill w-100" title="Tóm tắt nội dung bằng AI">
                    Auto Summary
                </button>
                
                @* Khu vực kết quả AI *@
                <div id="aiResult" class="d-none mt-4 p-3 bg-white border border-2 border-primary">
                    <h6 class="fw-bold text-primary mb-2">AI result</h6>
                    <p id="aiText" class="small mb-0 text-dark"></p>
                </div>

            </div>
        </div>

    </div>
</div>

@* Tích hợp AI *@
@section Scripts {
    <script>
            async function loadAiSummary(id) {
            const btn = document.getElementById('btnAiSummary');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm text-primary me-2" role="status"></span><span class="text-dark fw-bold">Analyze...</span>';

            try {
                const res = await fetch(`/Document/AiSummary/${id}`);

                if (!res.ok) {
                    throw new Error(`HTTP ${res.status}`);
                }

                const data = await res.json();
                document.getElementById('aiText').innerText = data.summary;
                document.getElementById('aiResult').classList.remove('d-none');
            } catch (err) {
                document.getElementById('aiText').innerText =
                    `Fail to connect: ${err.message}. Please try again.`;
                document.getElementById('aiResult').classList.remove('d-none');
            } finally {
                btn.innerHTML = 'Summary again';
                btn.disabled = false;
            }
        }
    </script>
}

@* Modal Out of Credits *@
<div class="modal fade" id="outOfCreditsModal" tabindex="-1" aria-labelledby="outOfCreditsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title fw-bold" id="outOfCreditsModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Out of Credits!
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <img src="https://cdn-icons-png.flaticon.com/512/5726/5726674.png" alt="No Credits" class="img-fluid mb-3" style="width: 100px;">
                <h4 class="fw-bold mb-3">You've reached your download limit</h4>
                <p class="text-muted mb-4">
                    Your current credit balance is <strong>0</strong>. You need credits to download study materials. What would you like to do?
                </p>
                <div class="d-grid gap-3">
                    <a asp-controller="Document" asp-action="Upload" class="btn btn-outline-primary btn-lg fw-bold">
                        <i class="bi bi-cloud-arrow-up me-2"></i>Upload to Earn (+2 Credits)
                    </a>
                    <!-- Nút này tạm thời để mồi, Giai đoạn 4 ta sẽ ráp VNPay vào đây -->
                    <a href="#" class="btn btn-warning btn-lg fw-bold text-dark disabled">
                        <i class="bi bi-lightning-charge-fill me-2"></i>Upgrade Plan (Coming soon)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>