@model UniDocs.Models.Document
@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-4">

    @* Tiêu đề và người đăng *@
    <div class="mb-4">
        <h2 class="text-primary fw-bold">@Model.Title</h2>
        <p class="text-muted">
            Môn học: <strong>@Model.Course?.CourseName</strong> |
            Người đăng: <strong>@Model.User?.LastName @Model.User?.FirstName</strong> |
            Ngày tải lên: @Model.UploadDate.ToString("dd/MM/yyyy")
        </p>
    </div>

    <div class="row g-4">
        @* Cột trái -> Khung đọc PDF *@
        <div class="col-lg-8">
            <div class="border rounded shadow-sm" style="height: 80vh;">
                <iframe src="@Model.FilePath" width="100%" height="100%" style="border: none;"></iframe>
            </div>
        </div>

        @* Cột phải -> Các nút tương tác *@
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Tương tác</h5>
                    <hr />
                    <p>Lượt tải: <strong>@Model.DownloadCount</strong></p>
                    <p>Mô tả: @Model.Description</p>

                    <div class="d-grid gap-2 mt-4">
                        <a asp-controller="Document" asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary btn-lg fw-bold">
                            <i class="bi bi-download"></i> Tải tài liệu về
                        </a>

                        <button class="btn btn-outline-danger fw-bold">
                            <i class="bi bi-bookmark-heart"></i> Lưu vào Yêu thích
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>