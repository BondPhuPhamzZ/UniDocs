@model UniDocs.Models.Document
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    
    @* ===== HEADER TRÊN CÙNG: Thông tin & Nút ===== *@
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 position-relative">
        
        @if (User.Identity!.IsAuthenticated)
        {
            @* Nút báo cáo ở góc trên cùng bên phải *@
            <a href="#" class="position-absolute top-0 end-0 mt-3 me-4 text-danger fs-5" data-bs-toggle="collapse" data-bs-target="#reportForm" title="Báo cáo tài liệu">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </a>
        }
        
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start">
            
            @* Bên trái: Thông tin tài liệu *@
            <div class="mb-3 mb-md-0">
                <h2 class="fw-bold text-dark mb-2">@Model.Title</h2>
                
                <div class="d-flex flex-wrap gap-2 text-muted small mb-3">
                    <span class="badge bg-light text-dark border p-2">Môn: @Model.Course?.CourseName</span>
                    <span class="badge bg-light text-dark border p-2">Năm học: @Model.AcademicYear</span>
                    <span class="badge bg-light text-dark border p-2">Loại: @Model.DocType</span>
                    <span class="badge bg-light text-dark border p-2">Lượt tải: @Model.DownloadCount</span>
                </div>

                <div class="small text-muted">
                    Người đăng: <span class="fw-bold text-dark">@Model.User?.LastName @Model.User?.FirstName</span> 
                    &bull; Ngày đăng: @Model.UploadDate.ToString("dd/MM/yyyy")
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="mt-3 small mb-0 text-dark border-start border-3 border-primary ps-2">@Model.Description</p>
                }
            </div>

            @* Bên phải: Nút thao tác *@
            <div class="d-flex flex-column gap-2" style="min-width: 250px;">
                
                @* Hàng 1: Tải tài liệu & Yêu thích (Icon) *@
                <div class="d-flex gap-2">
                    <a asp-controller="Document" asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary fw-bold rounded-pill flex-grow-1">
                        Tải tài liệu
                    </a>

                    <form asp-controller="Document" asp-action="SaveDocument" method="post" class="d-inline-block">
                        <input type="hidden" name="documentId" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger fw-bold rounded px-3" title="Thêm vào yêu thích">
                            <i class="bi bi-heart-fill"></i>
                        </button>
                    </form>
                </div>

                @* Hàng 2: Nút Tóm tắt AI *@
                <button id="btnAiSummary" onclick="loadAiSummary(@Model.Id)" class="btn btn-outline-primary fw-bold rounded-pill w-100" title="Tóm tắt nội dung bằng AI">
                    Tóm tắt
                </button>
                
                @if (User.Identity!.IsAuthenticated)
                {
                    <div class="collapse mt-3 text-start" id="reportForm">
                            <form asp-action="Report" asp-controller="Document" method="post">
                                <input type="hidden" name="documentId" value="@Model.Id" />
                                <select name="reason" class="form-select form-select-sm mb-2">
                                    <option>Nội dung sai / không liên quan</option>
                                    <option>Vi phạm bản quyền</option>
                                    <option>Tài liệu bị lỗi / không mở được</option>
                                    <option>Nội dung không phù hợp</option>
                                </select>
                                <button type="submit" class="btn btn-danger btn-sm w-100">Gửi</button>
                            </form>
                    </div>
                }

            </div>
        </div>
        
        @* Khu vực kết quả AI (hiển thị khi có) *@
        <div id="aiResult" class="d-none mt-4 p-3 bg-success-subtle rounded-3 border border-success">
            <h6 class="fw-bold text-success mb-2">Kết quả AI tóm tắt:</h6>
            <p id="aiText" class="small mb-0 text-dark"></p>
        </div>

    </div>

    @* ===== KHU VỰC ĐỌC PDF (FULL WIDTH) ===== *@
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
            <h6 class="mb-0 fw-bold text-light">Nội dung</h6>
            <a href="@Model.FilePath" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3">
                Toàn màn hình
            </a>
        </div>
        <div class="card-body p-0">
            <iframe src="@Model.FilePath" width="100%" height="900px" style="border: none; display: block;">
                Trình duyệt của bạn không hỗ trợ xem PDF trực tiếp.
            </iframe>
        </div>
    </div>

</div>

@* Tích hợp AI *@
@section Scripts {
    <script>
            async function loadAiSummary(id) {
            const btn = document.getElementById('btnAiSummary');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang phân tích...';

            try {
                const res = await fetch(`/Document/AiSummary/${id}`);

                // Thêm dòng debug
                if (!res.ok) {
                    throw new Error(`HTTP ${res.status}`);
                }

                const data = await res.json();
                document.getElementById('aiText').innerText = data.summary;
                document.getElementById('aiResult').classList.remove('d-none');
            } catch (err) {
                document.getElementById('aiText').innerText =
                    `Lỗi kết nối: ${err.message}. Vui lòng thử lại.`;
                document.getElementById('aiResult').classList.remove('d-none');
            } finally {
                btn.innerHTML = '<i class="bi bi-robot fs-5 me-2"></i>Tóm tắt lại';
                btn.disabled = false;
            }
        }
    </script>
}