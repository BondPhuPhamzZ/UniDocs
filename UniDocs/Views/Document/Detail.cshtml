@model UniDocs.Models.Document
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">
    <div class="row">

        @* Cột trái -> Hiển thị PDF *@
        <div class="col-lg-8 mb-4">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">

                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-file-earmark-pdf text-danger me-2"></i>Nội dung tài liệu</h6>

                    <a href="@Model.FilePath" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3">
                        <i class="bi bi-arrows-fullscreen"></i> Toàn màn hình
                    </a>
                </div>

                <div class="card-body p-0">
                    <iframe src="@Model.FilePath" width="100%" height="800px" style="border: none;">
                        Trình duyệt của bạn không hỗ trợ xem PDF trực tiếp.
                    </iframe>
                </div>

            </div>

        </div>

        @* ===== Cột PHẢI -> Thông tin và tương tác ===== *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 2rem;">

                <h3 class="fw-bold text-primary mb-3">@Model.Title</h3>

                <div class="mb-4">
                    <span class="badge bg-light text-dark border p-2 me-2 mb-2">
                        <i class="bi bi-book me-1 text-primary"></i> @Model.Course?.CourseName
                    </span>

                    <span class="badge bg-light text-dark border p-2 mb-2">
                        <i class="bi bi-calendar-event me-1 text-warning"></i> Năm học: @Model.AcademicYear
                    </span>

                    <span class="badge bg-light text-dark border p-2 mb-2">
                        <i class="bi bi-file-earmark-text me-1 text-success"></i> Loại: @Model.DocType
                    </span>
                </div>

                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-person-circle me-2"></i>Người đăng</span>
                        <span class="fw-bold">@Model.User?.LastName @Model.User?.FirstName</span>
                    </li>

                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-clock me-2"></i>Ngày tải lên</span>
                        <span>@Model.UploadDate.ToString("dd/MM/yyyy")</span>
                    </li>

                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center border-bottom-0">
                        <span class="text-muted"><i class="bi bi-cloud-download me-2"></i>Lượt tải</span>
                        <span class="badge bg-success rounded-pill px-3 py-2">@Model.DownloadCount</span>
                    </li>
                </ul>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="mb-4 bg-light p-3 rounded-3">
                        <h6 class="fw-bold text-muted mb-2">Mô tả thêm:</h6>
                        <p class="small mb-0 text-dark">@Model.Description</p>
                    </div>
                }

                <hr class="text-muted my-4" />

                @* Các nút tương tác *@
                <div class="d-grid gap-3">
                    <a asp-controller="Document" asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary btn-lg rounded-pill shadow-sm fw-bold">
                        <i class="bi bi-cloud-arrow-down fs-5 me-2"></i> Tải tài liệu
                    </a>

                    <form asp-controller="Document" asp-action="SaveDocument" method="post" class="mt-2">
                        <input type="hidden" name="documentId" value="@Model.Id" />
                        
                        <button type="submit" class="btn btn-outline-danger btn-lg rounded-pill shadow-sm fw-bold w-100 d-flex align-items-center justify-content-center">
                            <i class="bi bi-heart fs-5 me-2"></i> Lưu vào yêu thích
                        </button>
                    </form>

                    @* Báo cáo vi phạm *@
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <button class="btn btn-link btn-sm text-muted text-decoration-none"
                                data-bs-toggle="collapse" data-bs-target="#reportForm">
                            <i class="bi bi-flag me-1"></i>Báo cáo vi phạm
                        </button>
                        <div class="collapse mt-2" id="reportForm">
                            <form asp-action="Report" asp-controller="Document" method="post">
                                <input type="hidden" name="documentId" value="@Model.Id" />
                                <select name="reason" class="form-select form-select-sm mb-2">
                                    <option>Nội dung sai / không liên quan</option>
                                    <option>Vi phạm bản quyền</option>
                                    <option>Tài liệu bị lỗi / không mở được</option>
                                    <option>Nội dung không phù hợp</option>
                                </select>
                                <button type="submit" class="btn btn-danger btn-sm w-100">
                                    <i class="bi bi-send me-1"></i>Gửi báo cáo
                                </button>
                            </form>
                        </div>
                    }

                    
                    @* ===== AI tóm tắt và hiển thị ===== *@
                    @* Nút AI tóm tắt *@
                    <button id="btnAiSummary" onclick="loadAiSummary(@Model.Id)"
                            class="btn btn-outline-success btn-lg rounded-pill shadow-sm fw-bold w-100">
                        <i class="bi bi-robot fs-5 me-2"></i> Tóm tắt bằng AI
                    </button>

                    @* Khu vực hiển thị kết quả AI *@
                    <div id="aiResult" class="d-none mt-3 p-3 bg-light rounded-3 border border-success">
                        <h6 class="fw-bold text-success mb-2"><i class="bi bi-robot me-1"></i>AI tóm tắt:</h6>
                        <p id="aiText" class="small mb-0 text-dark"></p>
                    </div>


                </div>

            </div>
        </div>

    </div>
</div>

<style>
    .hover-primary:hover {
        color: #0d6efd !important;
        text-decoration: underline !important;
    }
</style>

@* Tích hợp AI *@
@section Scripts {
    <script>
        async function loadAiSummary(id) {
            const btn = document.getElementById('btnAiSummary');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang phân tích...';

            const res = await fetch(`/Document/AiSummary/${id}`);
            const data = await res.json();

            document.getElementById('aiText').innerText = data.summary;
            document.getElementById('aiResult').classList.remove('d-none');
            btn.innerHTML = '<i class="bi bi-robot fs-5 me-2"></i>Tóm tắt lại';
            btn.disabled = false;
        }
    </script>
}